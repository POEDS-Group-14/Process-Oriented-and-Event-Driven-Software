        <bpmn:flowNodeRef>B_Payment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0a4e7cd" name="Inspector">
        <bpmn:flowNodeRef>Event_0hsgsuj</bpmn:flowNodeRef>
