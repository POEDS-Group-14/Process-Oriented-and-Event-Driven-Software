    <bpmn:messageFlow id="MF_Forward" name="Complaint (case data)" sourceRef="T_Hold" targetRef="Participant_0wmk0u0" />
    <bpmn:messageFlow id="MF_Outcome" name="Outcome" sourceRef="Participant_0wmk0u0" targetRef="E_Outcome" />
    <bpmn:messageFlow id="MF_Transfer" name="Claim with CPR" sourceRef="S_Transfer" targetRef="Participant_1xqxepe" />
  </bpmn:collaboration>
