        <bpmn:flowNodeRef>Activity_11xzb3l</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_IdProvided</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_IdEstablished</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_HandedPolice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_059s3c6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_PoliceMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_02u767f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0io5juq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_175whz0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1n5vurl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_19ecgf6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="F_finesToSig" sourceRef="Activity_19ecgf6" targetRef="Activity_175whz0" />
    <bpmn:sequenceFlow id="F_upheld" name="Upheld or reduced" sourceRef="G_Outcome" targetRef="T_Decision">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${outcome != 'cancelled'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_cancel" name="Cancelled" sourceRef="G_Outcome" targetRef="E_Cancelled">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${outcome == 'cancelled'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_c3" sourceRef="E_Outcome" targetRef="G_Outcome" />
    <bpmn:sequenceFlow id="F_c2" sourceRef="T_Hold" targetRef="E_Outcome" />
    <bpmn:sequenceFlow id="F_c1" sourceRef="B_Complaint" targetRef="T_Hold" />
    <bpmn:sequenceFlow id="F_pay2" sourceRef="T_RegPayment" targetRef="E_Paid" />
    <bpmn:sequenceFlow id="F_pay1" sourceRef="B_Payment" targetRef="T_RegPayment" />
    <bpmn:sequenceFlow id="F_collectEnd" sourceRef="SP_Collect" targetRef="E_Collection" />
    <bpmn:sequenceFlow id="F_toCollect" sourceRef="G_M0" targetRef="SP_Collect" />
    <bpmn:sequenceFlow id="F_decisionLoop" sourceRef="T_Decision" targetRef="G_M0" />
    <bpmn:sequenceFlow id="F_invM0" sourceRef="T_Invoice" targetRef="G_M0" />
    <bpmn:sequenceFlow id="F_reg" sourceRef="T_Register" targetRef="T_Invoice" />
    <bpmn:sequenceFlow id="F_rcpt" sourceRef="Activity_175whz0" targetRef="T_Register" />
    <bpmn:sequenceFlow id="F_toFines" sourceRef="Gateway_0io5juq" targetRef="Activity_19ecgf6" />
    <bpmn:sequenceFlow id="F_ToPolice" sourceRef="G_PoliceMerge" targetRef="Activity_02u767f" />
    <bpmn:sequenceFlow id="Flow_1wdlysu" name="No" sourceRef="Gateway_059s3c6" targetRef="Gateway_0io5juq">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${!nameFlagged}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0puaivk" name="Yes, in doubt" sourceRef="Gateway_059s3c6" targetRef="G_PoliceMerge">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${nameFlagged}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0rv3ddc" sourceRef="Activity_1n5vurl" targetRef="Gateway_059s3c6" />
    <bpmn:sequenceFlow id="F_EstNo" name="No" sourceRef="G_IdEstablished" targetRef="E_HandedPolice">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${!identityEstablished}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_EstYes" name="Yes" sourceRef="G_IdEstablished" targetRef="Gateway_0io5juq">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${identityEstablished}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_PoliceToEst" sourceRef="Activity_02u767f" targetRef="G_IdEstablished" />
    <bpmn:sequenceFlow id="F_IdNo" name="No" sourceRef="G_IdProvided" targetRef="G_PoliceMerge">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${!idProvided}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_IdYes" name="Yes" sourceRef="G_IdProvided" targetRef="Activity_1n5vurl">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${idProvided}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_186chsv" sourceRef="Activity_11xzb3l" targetRef="G_IdProvided" />
    <bpmn:sequenceFlow id="Flow_0mlks6q" name="No" sourceRef="Gateway_08r434n" targetRef="Activity_11xzb3l">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${ticketResult != 'valid'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1tibn89" name="Yes" sourceRef="Gateway_08r434n" targetRef="Event_0s0bp8u">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${ticketResult == 'valid'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0vcg2md" sourceRef="Activity_1kr6qnw" targetRef="Gateway_08r434n" />
    <bpmn:sequenceFlow id="Flow_1drjxa7" sourceRef="Event_0hsgsuj" targetRef="Activity_1kr6qnw" />
    <bpmn:boundaryEvent id="B_Payment" name="Payment received" attachedToRef="SP_Collect">
      <bpmn:outgoing>F_pay1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_PaymentReceived" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_Complaint" name="Complaint received" attachedToRef="SP_Collect">
      <bpmn:outgoing>F_c1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ComplaintReceived" />
    </bpmn:boundaryEvent>
    <bpmn:receiveTask id="Activity_175whz0" name="Get passenger signature" messageRef="Message_ReceiptSigned">
      <bpmn:incoming>F_finesToSig</bpmn:incoming>
      <bpmn:outgoing>F_rcpt</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_Receipt">
        <bpmn:targetRef>DataObjectRef_Receipt</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:receiveTask>
    <bpmn:subProcess id="Activity_19ecgf6" name="Issue fine per passenger">
      <bpmn:incoming>F_toFines</bpmn:incoming>
      <bpmn:outgoing>F_finesToSig</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
      <bpmn:startEvent id="Event_1uu92b5">
        <bpmn:outgoing>F_mi1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:businessRuleTask id="Activity_17rxljv" name="Determine fine recipient" camunda:resultVariable="fineRecipient" camunda:decisionRef="fineRecipient" camunda:mapDecisionResult="singleEntry">
        <bpmn:incoming>F_mi1</bpmn:incoming>
        <bpmn:outgoing>F_mi3</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:businessRuleTask id="Activity_0k4vh2e" name="Set amount" camunda:resultVariable="fineAmount" camunda:decisionRef="fineAmount" camunda:mapDecisionResult="singleEntry">
        <bpmn:incoming>F_mi3</bpmn:incoming>
        <bpmn:outgoing>F_mi4</bpmn:outgoing>
      </bpmn:businessRuleTask>
      <bpmn:userTask id="Activity_0ml3ezc" name="Issue fine">
        <bpmn:incoming>F_mi4</bpmn:incoming>
        <bpmn:outgoing>F_mi5</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DataOut_FineSlip">
          <bpmn:targetRef>DataObjectRef_FineSlip</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:userTask>
      <bpmn:endEvent id="Event_0uxw663">
        <bpmn:incoming>F_mi5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="F_mi1" sourceRef="Event_1uu92b5" targetRef="Activity_17rxljv" />
      <bpmn:sequenceFlow id="F_mi3" sourceRef="Activity_17rxljv" targetRef="Activity_0k4vh2e" />
      <bpmn:sequenceFlow id="F_mi4" sourceRef="Activity_0k4vh2e" targetRef="Activity_0ml3ezc" />
      <bpmn:sequenceFlow id="F_mi5" sourceRef="Activity_0ml3ezc" targetRef="Event_0uxw663" />
    </bpmn:subProcess>
    <bpmn:sendTask id="T_Decision" name="Send decision with new deadline">
      <bpmn:documentation>Sends the decision with a new payment deadline (14 days, assumed) and, if P3 reduced the fine, the new amount.</bpmn:documentation>
      <bpmn:incoming>F_upheld</bpmn:incoming>
      <bpmn:outgoing>F_decisionLoop</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_Cancelled" name="Fine cancelled">
      <bpmn:incoming>F_cancel</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_Outcome" name="Outcome?">
      <bpmn:incoming>F_c3</bpmn:incoming>
      <bpmn:outgoing>F_cancel</bpmn:outgoing>
      <bpmn:outgoing>F_upheld</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="E_Outcome" name="Outcome received">
      <bpmn:incoming>F_c2</bpmn:incoming>
      <bpmn:outgoing>F_c3</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_P3Outcome" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="T_Hold" name="Forward complaint to P3">
      <bpmn:incoming>F_c1</bpmn:incoming>
      <bpmn:outgoing>F_c2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_Paid" name="Paid">
      <bpmn:incoming>F_pay2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_RegPayment" name="Register payment">
      <bpmn:incoming>F_pay1</bpmn:incoming>
      <bpmn:outgoing>F_pay2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_Collection" name="Sent to collection">
      <bpmn:incoming>F_collectEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SP_Collect" name="Collect payment">
      <bpmn:incoming>F_toCollect</bpmn:incoming>
      <bpmn:outgoing>F_collectEnd</bpmn:outgoing>
      <bpmn:startEvent id="S_Start" name="">
        <bpmn:outgoing>SF1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="S_M1">
        <bpmn:incoming>SF1</bpmn:incoming>
        <bpmn:incoming>SF_loopNew</bpmn:incoming>
        <bpmn:incoming>SF_loopYes</bpmn:incoming>
        <bpmn:outgoing>SF2</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:eventBasedGateway id="S_EBG" name="Wait for payment deadline">
        <bpmn:incoming>SF2</bpmn:incoming>
        <bpmn:outgoing>SF_toPost</bpmn:outgoing>
        <bpmn:outgoing>SF_toDeadline</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="S_Post" name="Postponement requested">
        <bpmn:incoming>SF_toPost</bpmn:incoming>
        <bpmn:outgoing>SF3</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_PostponementRequested" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="S_Already" name="Already postponed?">
        <bpmn:incoming>SF3</bpmn:incoming>
        <bpmn:outgoing>SF_new</bpmn:outgoing>
        <bpmn:outgoing>SF_loopYes</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="S_NewDeadline" name="Set new deadline">
        <bpmn:incoming>SF_new</bpmn:incoming>
        <bpmn:outgoing>SF_loopNew</bpmn:outgoing>
      </bpmn:task>
      <bpmn:intermediateCatchEvent id="S_Deadline" name="Payment deadline passed">
        <bpmn:incoming>SF_toDeadline</bpmn:incoming>
        <bpmn:outgoing>SF4</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDate xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${paymentDeadline}</bpmn:timeDate>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:sendTask id="S_Rem1" name="Send reminder 1">
        <bpmn:incoming>SF4</bpmn:incoming>
        <bpmn:outgoing>SF5</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="S_T10a" name="10 days">
        <bpmn:incoming>SF5</bpmn:incoming>
        <bpmn:outgoing>SF6</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">P10D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:sendTask id="S_Rem2" name="Send reminder 2">
        <bpmn:incoming>SF6</bpmn:incoming>
        <bpmn:outgoing>SF7</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:intermediateCatchEvent id="S_T10b" name="10 days">
        <bpmn:incoming>SF7</bpmn:incoming>
        <bpmn:outgoing>SF8</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeDuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">P10D</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:sendTask id="S_Transfer" name="Transfer to Gældsstyrelsen">
        <bpmn:incoming>SF8</bpmn:incoming>
        <bpmn:outgoing>SF9</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="S_End" name="Transferred">
        <bpmn:incoming>SF9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SF1" sourceRef="S_Start" targetRef="S_M1" />
      <bpmn:sequenceFlow id="SF2" sourceRef="S_M1" targetRef="S_EBG" />
      <bpmn:sequenceFlow id="SF_toPost" sourceRef="S_EBG" targetRef="S_Post" />
      <bpmn:sequenceFlow id="SF3" sourceRef="S_Post" targetRef="S_Already" />
      <bpmn:sequenceFlow id="SF_new" name="No" sourceRef="S_Already" targetRef="S_NewDeadline">
        <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${execution.getVariable('postponed') != true}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="SF_loopNew" sourceRef="S_NewDeadline" targetRef="S_M1" />
      <bpmn:sequenceFlow id="SF_loopYes" name="Yes" sourceRef="S_Already" targetRef="S_M1">
        <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">${execution.getVariable('postponed') == true}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="SF_toDeadline" sourceRef="S_EBG" targetRef="S_Deadline" />
      <bpmn:sequenceFlow id="SF4" sourceRef="S_Deadline" targetRef="S_Rem1" />
      <bpmn:sequenceFlow id="SF5" sourceRef="S_Rem1" targetRef="S_T10a" />
      <bpmn:sequenceFlow id="SF6" sourceRef="S_T10a" targetRef="S_Rem2" />
      <bpmn:sequenceFlow id="SF7" sourceRef="S_Rem2" targetRef="S_T10b" />
      <bpmn:sequenceFlow id="SF8" sourceRef="S_T10b" targetRef="S_Transfer" />
      <bpmn:sequenceFlow id="SF9" sourceRef="S_Transfer" targetRef="S_End" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="G_M0">
      <bpmn:incoming>F_invM0</bpmn:incoming>
      <bpmn:incoming>F_decisionLoop</bpmn:incoming>
      <bpmn:outgoing>F_toCollect</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:dataObjectReference id="DO_InvoiceRef" name="Invoice (FIK code)" dataObjectRef="DataObject_Invoice" />
    <bpmn:dataObject id="DataObject_Invoice" />
    <bpmn:sendTask id="T_Invoice" name="Send invoice">
      <bpmn:incoming>F_reg</bpmn:incoming>
      <bpmn:outgoing>F_invM0</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DO_Invoice">
        <bpmn:targetRef>DO_InvoiceRef</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:sendTask>
    <bpmn:dataStoreReference id="DS_FineRegister" name="Fine register" />
    <bpmn:task id="T_Register" name="Register fine">
      <bpmn:incoming>F_rcpt</bpmn:incoming>
      <bpmn:outgoing>F_reg</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DO_Register">
        <bpmn:targetRef>DS_FineRegister</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataObjectReference id="DataObjectRef_Receipt" name="Signed receipt" dataObjectRef="DataObject_Receipt" />
    <bpmn:dataObject id="DataObject_Receipt" />
