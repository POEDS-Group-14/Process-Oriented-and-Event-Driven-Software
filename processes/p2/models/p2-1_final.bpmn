        <bpmn:flowNodeRef>T_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_Payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RegPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Paid</bpmn:flowNodeRef>
