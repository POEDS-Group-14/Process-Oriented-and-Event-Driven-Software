    <bpmn:messageFlow id="MF_Rem2" name="Reminder 2" sourceRef="S_Rem2" targetRef="Participant_1xnwp1y" />
    <bpmn:messageFlow id="MF_Complaint" name="Complaint" sourceRef="Participant_1xnwp1y" targetRef="B_Complaint" />
    <bpmn:messageFlow id="MF_Payment" name="Payment" sourceRef="Participant_1xnwp1y" targetRef="B_Payment" />
    <bpmn:messageFlow id="MF_Decision" name="Decision with new deadline" sourceRef="T_Decision" targetRef="Participant_1xnwp1y" />
    <bpmn:messageFlow id="MF_Forward" name="Complaint" sourceRef="T_Hold" targetRef="Participant_0wmk0u0" />
    <bpmn:messageFlow id="MF_Outcome" name="Outcome" sourceRef="Participant_0wmk0u0" targetRef="E_Outcome" />
    <bpmn:messageFlow id="MF_Transfer" name="Claim with CPR" sourceRef="S_Transfer" targetRef="Participant_1xqxepe" />
  </bpmn:collaboration>
  <bpmn:message id="Message_ReceiptSigned" name="ReceiptSigned" />
  <bpmn:message id="Message_PostponementRequested" name="PostponementRequested" />
  <bpmn:message id="Message_PaymentReceived" name="PaymentReceived" />
  <bpmn:message id="Message_ComplaintReceived" name="ComplaintReceived" />
  <bpmn:message id="Message_P3Outcome" name="P3Outcome" />
  <bpmn:process id="Process_07ecq23" isExecutable="false">
    <bpmn:laneSet id="LaneSet_0adplqg">
      <bpmn:lane id="Lane_0cms5b4" name="Fine Office">
        <bpmn:flowNodeRef>T_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Invoice</bpmn:flowNodeRef>
