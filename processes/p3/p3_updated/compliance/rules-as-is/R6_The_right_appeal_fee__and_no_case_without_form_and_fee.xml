<?xml version="1.0" encoding="UTF-8"?>
<dcr:definitions xmlns:dcr="http://tk/schema/dcr" xmlns:dcrDi="http://tk/schema/dcrDi" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC">
  <dcr:dcrGraph id="dcrGraph">
    <dcr:nesting id="Fee" description="Appeal fee">
      <dcr:event id="PayFee160" role="Passenger" description="Pay fee 160 kr" included="false" executed="false" pending="false" enabled="false" />
      <dcr:event id="PayFee80" role="Passenger" description="Pay fee 80 kr" included="false" executed="false" pending="false" enabled="false" />
    </dcr:nesting>
    <dcr:event id="SubmitForm" role="Passenger" description="Submit appeal form" included="true" executed="false" pending="false" enabled="false">
      <dcr:eventData name="amount" type="Int" />
    </dcr:event>
    <dcr:event id="CreateCase" role="Secretariat" description="Create case" included="true" executed="false" pending="false" enabled="false" />
    <dcr:relation id="R_0" type="include" sourceRef="SubmitForm" targetRef="PayFee160" guard="amount &gt;= 160" />
    <dcr:relation id="R_1" type="include" sourceRef="SubmitForm" targetRef="PayFee80" guard="amount &lt; 160" />
    <dcr:relation id="R_2" type="condition" sourceRef="SubmitForm" targetRef="CreateCase" />
    <dcr:relation id="R_3" type="condition" sourceRef="Fee" targetRef="CreateCase" />
  </dcr:dcrGraph>
  <dcrDi:dcrRootBoard id="RootBoard">
    <dcrDi:dcrPlane id="Plane" boardElement="dcrGraph">
      <dcrDi:dcrShape id="SubmitForm_di" boardElement="SubmitForm">
        <dc:Bounds x="140" y="115" width="130" height="150" />
      </dcrDi:dcrShape>
      <dcrDi:dcrShape id="Fee_di" boardElement="Fee">
        <dc:Bounds x="420" y="40" width="180" height="440" />
      </dcrDi:dcrShape>
      <dcrDi:dcrShape id="PayFee160_di" boardElement="PayFee160">
        <dc:Bounds x="445" y="115" width="130" height="150" />
      </dcrDi:dcrShape>
      <dcrDi:dcrShape id="PayFee80_di" boardElement="PayFee80">
        <dc:Bounds x="445" y="305" width="130" height="150" />
      </dcrDi:dcrShape>
      <dcrDi:dcrShape id="CreateCase_di" boardElement="CreateCase">
        <dc:Bounds x="750" y="115" width="130" height="150" />
      </dcrDi:dcrShape>
      <dcrDi:relation id="R_0_di" boardElement="R_0">
        <dcrDi:waypoint x="270" y="155" />
        <dcrDi:waypoint x="358" y="155" />
        <dcrDi:waypoint x="358" y="155" />
        <dcrDi:waypoint x="445" y="155" />
      </dcrDi:relation>
      <dcrDi:relation id="R_1_di" boardElement="R_1">
        <dcrDi:waypoint x="270" y="155" />
        <dcrDi:waypoint x="358" y="155" />
        <dcrDi:waypoint x="358" y="345" />
        <dcrDi:waypoint x="445" y="345" />
      </dcrDi:relation>
      <dcrDi:relation id="R_2_di" boardElement="R_2">
        <dcrDi:waypoint x="205" y="115" />
        <dcrDi:waypoint x="205" y="20" />
        <dcrDi:waypoint x="815" y="20" />
        <dcrDi:waypoint x="815" y="115" />
      </dcrDi:relation>
      <dcrDi:relation id="R_3_di" boardElement="R_3">
        <dcrDi:waypoint x="600" y="80" />
        <dcrDi:waypoint x="675" y="80" />
        <dcrDi:waypoint x="675" y="155" />
        <dcrDi:waypoint x="750" y="155" />
      </dcrDi:relation>
    </dcrDi:dcrPlane>
  </dcrDi:dcrRootBoard>
</dcr:definitions>
