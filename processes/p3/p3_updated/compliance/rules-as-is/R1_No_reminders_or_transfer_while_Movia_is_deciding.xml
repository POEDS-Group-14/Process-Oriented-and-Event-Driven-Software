<?xml version="1.0" encoding="UTF-8"?>
<dcr:definitions xmlns:dcr="http://tk/schema/dcr" xmlns:dcrDi="http://tk/schema/dcrDi" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC">
  <dcr:dcrGraph id="dcrGraph">
    <dcr:nesting id="Complaint" description="Complaint">
      <dcr:event id="Complain" role="Passenger" description="Complain to operator" included="true" executed="false" pending="false" enabled="false">
        <dcr:eventData name="onBehalfOfAdult" type="Bool" />
      </dcr:event>
      <dcr:event id="ComplainMisuse" role="Passenger" description="Complain about identity misuse" included="true" executed="false" pending="false" enabled="false" />
    </dcr:nesting>
    <dcr:nesting id="Decision" description="Movia decides">
      <dcr:event id="AcceptCompl" role="Operator" description="Accept complaint" included="false" executed="false" pending="false" enabled="false" />
      <dcr:event id="RejectCompl" role="Operator" description="Reject complaint" included="false" executed="false" pending="false" enabled="false" />
      <dcr:event id="ReduceFine" role="Operator" description="Reduce fine" included="false" executed="false" pending="false" enabled="false" />
    </dcr:nesting>
    <dcr:nesting id="Collection" description="Collection">
