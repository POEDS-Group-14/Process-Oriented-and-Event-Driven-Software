      <dcr:event id="Transfer" role="Operator" description="Transfer to Gaeldsstyrelsen (P2)" included="true" executed="false" pending="false" enabled="false" />
    </dcr:nesting>
    <dcr:relation id="R_0" type="include" sourceRef="Complaint" targetRef="Decision" />
    <dcr:relation id="R_1" type="response" sourceRef="Complaint" targetRef="Decision" />
    <dcr:relation id="R_2" type="exclude" sourceRef="Decision" targetRef="Decision" />
    <dcr:relation id="R_3" type="milestone" sourceRef="Decision" targetRef="Collection" />
  </dcr:dcrGraph>
