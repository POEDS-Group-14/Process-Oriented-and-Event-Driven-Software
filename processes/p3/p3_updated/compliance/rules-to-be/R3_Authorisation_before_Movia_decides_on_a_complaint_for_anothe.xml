<?xml version="1.0" encoding="UTF-8"?>
<dcr:definitions xmlns:dcr="http://tk/schema/dcr" xmlns:dcrDi="http://tk/schema/dcrDi" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC">
  <dcr:dcrGraph id="dcrGraph">
    <dcr:nesting id="Decision" description="Movia decides">
      <dcr:event id="AcceptCompl" role="Operator" description="Accept complaint" included="true" executed="false" pending="false" enabled="false" />
      <dcr:event id="RejectCompl" role="Operator" description="Reject complaint" included="true" executed="false" pending="false" enabled="false" />
      <dcr:event id="ReduceFine" role="Operator" description="Reduce fine" included="true" executed="false" pending="false" enabled="false" />
    </dcr:nesting>
    <dcr:event id="Complain" role="Passenger" description="Complain to operator" included="true" executed="false" pending="false" enabled="false">
      <dcr:eventData name="onBehalfOfAdult" type="Bool" />
    </dcr:event>
    <dcr:event id="AttachAuth" role="Passenger" description="Attach authorisation" included="false" executed="false" pending="false" enabled="false" />
    <dcr:relation id="R_0" type="include" sourceRef="Complain" targetRef="AttachAuth" guard="onBehalfOfAdult = true" />
    <dcr:relation id="R_1" type="response" sourceRef="Complain" targetRef="AttachAuth" guard="onBehalfOfAdult = true" />
    <dcr:relation id="R_2" type="milestone" sourceRef="AttachAuth" targetRef="Decision" />
  </dcr:dcrGraph>
  <dcrDi:dcrRootBoard id="RootBoard">
    <dcrDi:dcrPlane id="Plane" boardElement="dcrGraph">
      <dcrDi:dcrShape id="Complain_di" boardElement="Complain">
        <dc:Bounds x="140" y="115" width="130" height="150" />
      </dcrDi:dcrShape>
      <dcrDi:dcrShape id="AttachAuth_di" boardElement="AttachAuth">
        <dc:Bounds x="420" y="115" width="130" height="150" />
      </dcrDi:dcrShape>
      <dcrDi:dcrShape id="Decision_di" boardElement="Decision">
        <dc:Bounds x="700" y="40" width="180" height="630" />
      </dcrDi:dcrShape>
      <dcrDi:dcrShape id="AcceptCompl_di" boardElement="AcceptCompl">
        <dc:Bounds x="725" y="115" width="130" height="150" />
      </dcrDi:dcrShape>
      <dcrDi:dcrShape id="RejectCompl_di" boardElement="RejectCompl">
        <dc:Bounds x="725" y="305" width="130" height="150" />
      </dcrDi:dcrShape>
      <dcrDi:dcrShape id="ReduceFine_di" boardElement="ReduceFine">
        <dc:Bounds x="725" y="495" width="130" height="150" />
      </dcrDi:dcrShape>
      <dcrDi:relation id="R_0_di" boardElement="R_0">
        <dcrDi:waypoint x="270" y="155" />
        <dcrDi:waypoint x="345" y="155" />
        <dcrDi:waypoint x="345" y="155" />
        <dcrDi:waypoint x="420" y="155" />
      </dcrDi:relation>
      <dcrDi:relation id="R_1_di" boardElement="R_1">
        <dcrDi:waypoint x="270" y="169" />
        <dcrDi:waypoint x="352" y="169" />
        <dcrDi:waypoint x="352" y="169" />
        <dcrDi:waypoint x="420" y="169" />
      </dcrDi:relation>
      <dcrDi:relation id="R_2_di" boardElement="R_2">
        <dcrDi:waypoint x="550" y="155" />
        <dcrDi:waypoint x="625" y="155" />
        <dcrDi:waypoint x="625" y="80" />
        <dcrDi:waypoint x="700" y="80" />
      </dcrDi:relation>
    </dcrDi:dcrPlane>
  </dcrDi:dcrRootBoard>
</dcr:definitions>
