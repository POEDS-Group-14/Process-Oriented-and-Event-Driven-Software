<?xml version="1.0" encoding="UTF-8"?>
<dcr:definitions xmlns:dcr="http://tk/schema/dcr" xmlns:dcrDi="http://tk/schema/dcrDi" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC">
  <dcr:dcrGraph id="dcrGraph">
    <dcr:nesting id="Board" description="Board decision">
      <dcr:event id="Uphold" role="Board" description="Uphold complaint (fine cancelled)" included="false" executed="false" pending="false" enabled="false" />
      <dcr:event id="RejectAppeal" role="Board" description="Reject appeal" included="false" executed="false" pending="false" enabled="false" />
    </dcr:nesting>
    <dcr:nesting id="Closers" description="Close without a decision">
      <dcr:event id="Withdraw" role="Passenger" description="Withdraw" included="true" executed="false" pending="false" enabled="false" />
      <dcr:event id="Settle" role="Operator" description="Settle" included="true" executed="false" pending="false" enabled="false" />
      <dcr:event id="RejectCase" role="Secretariat" description="Reject case" included="true" executed="false" pending="false" enabled="false" />
    </dcr:nesting>
    <dcr:nesting id="Collection" description="Collection">
      <dcr:event id="SendReminder" role="Operator" description="Send reminder (P2)" included="true" executed="false" pending="false" enabled="false" />
      <dcr:event id="Transfer" role="Operator" description="Transfer to Gaeldsstyrelsen (P2)" included="true" executed="false" pending="false" enabled="false" />
    </dcr:nesting>
    <dcr:event id="CreateCase" role="System" description="Create case" included="true" executed="false" pending="false" enabled="false" />
    <dcr:relation id="R_0" type="include" sourceRef="CreateCase" targetRef="Board" />
    <dcr:relation id="R_1" type="response" sourceRef="CreateCase" targetRef="Board" />
    <dcr:relation id="R_2" type="exclude" sourceRef="Board" targetRef="Board" />
    <dcr:relation id="R_3" type="exclude" sourceRef="Closers" targetRef="Board" />
    <dcr:relation id="R_4" type="milestone" sourceRef="Board" targetRef="Collection" />
  </dcr:dcrGraph>
  <dcrDi:dcrRootBoard id="RootBoard">
