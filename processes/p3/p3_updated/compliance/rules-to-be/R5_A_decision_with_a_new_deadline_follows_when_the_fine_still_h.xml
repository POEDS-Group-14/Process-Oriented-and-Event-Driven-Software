<?xml version="1.0" encoding="UTF-8"?>
<dcr:definitions xmlns:dcr="http://tk/schema/dcr" xmlns:dcrDi="http://tk/schema/dcrDi" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC">
  <dcr:dcrGraph id="dcrGraph">
    <dcr:nesting id="Due" description="Fine still has to be paid">
      <dcr:event id="RejectCompl" role="Operator" description="Reject complaint" included="true" executed="false" pending="false" enabled="false" />
      <dcr:event id="ReduceFine" role="Operator" description="Reduce fine" included="true" executed="false" pending="false" enabled="false" />
      <dcr:event id="RejectAppeal" role="Board" description="Reject appeal" included="true" executed="false" pending="false" enabled="false" />
    </dcr:nesting>
    <dcr:event id="NewDeadline" role="Operator" description="Send decision with new deadline(P2)" included="true" executed="false" pending="false" enabled="false">
      <dcr:eventData name="newAmount" type="Int" />
    </dcr:event>
    <dcr:relation id="R_0" type="response" sourceRef="Due" targetRef="NewDeadline" />
  </dcr:dcrGraph>
  <dcrDi:dcrRootBoard id="RootBoard">
    <dcrDi:dcrPlane id="Plane" boardElement="dcrGraph">
      <dcrDi:dcrShape id="Due_di" boardElement="Due">
        <dc:Bounds x="140" y="40" width="180" height="630" />
      </dcrDi:dcrShape>
      <dcrDi:dcrShape id="RejectCompl_di" boardElement="RejectCompl">
        <dc:Bounds x="165" y="115" width="130" height="150" />
      </dcrDi:dcrShape>
      <dcrDi:dcrShape id="ReduceFine_di" boardElement="ReduceFine">
        <dc:Bounds x="165" y="305" width="130" height="150" />
      </dcrDi:dcrShape>
      <dcrDi:dcrShape id="RejectAppeal_di" boardElement="RejectAppeal">
        <dc:Bounds x="165" y="495" width="130" height="150" />
      </dcrDi:dcrShape>
      <dcrDi:dcrShape id="NewDeadline_di" boardElement="NewDeadline">
        <dc:Bounds x="470" y="115" width="130" height="150" />
      </dcrDi:dcrShape>
      <dcrDi:relation id="R_0_di" boardElement="R_0">
        <dcrDi:waypoint x="320" y="80" />
        <dcrDi:waypoint x="395" y="80" />
        <dcrDi:waypoint x="395" y="155" />
        <dcrDi:waypoint x="470" y="155" />
      </dcrDi:relation>
    </dcrDi:dcrPlane>
  </dcrDi:dcrRootBoard>
</dcr:definitions>
