<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P5" targetNamespace="http://example.org/p5" exporter="P5 generator" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_P5">
    <bpmn:participant id="P_OP" name="Operating railway company and train staff (DSB, GoCollective, NT/NJ, MT/MJ, Lokaltog, Skånetrafiken)" />
    <bpmn:participant id="P_PAX" name="Passenger with reduced mobility" processRef="Proc_Pax" />
    <bpmn:participant id="P_DSB" name="DSB Kundecenter - Handicapservice" processRef="Proc_DSB" />
    <bpmn:participant id="P_PRV" name="Assistance provider at station" processRef="Proc_Prv" />
    <bpmn:messageFlow id="m_01" name="Booking request" sourceRef="t_book" targetRef="s_req" />
    <bpmn:messageFlow id="m_02" name="Confirmation" sourceRef="t_reg" targetRef="c_conf" />
    <bpmn:messageFlow id="m_03" name="Decline" sourceRef="e_no" targetRef="c_decl" />
    <bpmn:messageFlow id="m_04" name="Travel plan" sourceRef="t_send" targetRef="c_plan" />
    <bpmn:messageFlow id="m_05" name="Booking details [R13]" sourceRef="t_ord" targetRef="P_OP" />
    <bpmn:messageFlow id="m_06" name="Assistance order" sourceRef="t_ord" targetRef="s_ord" />
    <bpmn:messageFlow id="m_07" name="Ramp request" sourceRef="t_spont" targetRef="P_OP" />
    <bpmn:messageFlow id="m_08" name="Passenger reports [R24]" sourceRef="t_report" targetRef="t_meet" />
    <bpmn:messageFlow id="m_09" name="Help call" sourceRef="t_call" targetRef="s_help" />
    <bpmn:messageFlow id="m_10" name="Disruption notice [R13]" sourceRef="P_OP" targetRef="s_help" />
    <bpmn:messageFlow id="m_11" name="New arrangement" sourceRef="t_inf" targetRef="c_new" />
    <bpmn:messageFlow id="m_12" name="Changed order" sourceRef="t_inf" targetRef="s_ord" />
    <bpmn:messageFlow id="m_13" name="Assistance [R03]" sourceRef="t_lift" targetRef="t_board" />
    <bpmn:messageFlow id="m_14" name="Assistance report [R33]" sourceRef="t_rep" targetRef="s_rep" />
    <bpmn:messageFlow id="m_15" name="Help request to train staff" sourceRef="t_staff" targetRef="P_OP" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Pax" name="P5 AS-IS: passenger" isExecutable="false">
    <bpmn:startEvent id="s_need" name="Needs help boarding or alighting [R01]">
      <bpmn:outgoing>f_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g_book" name="Advance booking needed? [R06]">
      <bpmn:incoming>f_01</bpmn:incoming>
      <bpmn:outgoing>f_02</bpmn:outgoing>
      <bpmn:outgoing>f_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_spont" name="Travel spontaneously: signal driver or train staff for ramp [R07]">
      <bpmn:incoming>f_02</bpmn:incoming>
      <bpmn:outgoing>f_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e_spont" name="Journey completed without booking">
      <bpmn:incoming>f_03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t_book" name="Book Handicapservice by phone or web form [R08]">
      <bpmn:incoming>f_04</bpmn:incoming>
      <bpmn:outgoing>f_05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="c_conf" name="Confirmation received [R14]">
      <bpmn:incoming>f_05</bpmn:incoming>
      <bpmn:outgoing>f_06</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c_conf_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="g_evt">
      <bpmn:incoming>f_06</bpmn:incoming>
      <bpmn:outgoing>f_07</bpmn:outgoing>
      <bpmn:outgoing>f_09</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="c_decl" name="Decline received">
      <bpmn:incoming>f_07</bpmn:incoming>
      <bpmn:outgoing>f_08</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c_decl_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e_decl" name="Journey not assisted">
      <bpmn:incoming>f_08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="c_plan" name="Travel plan with meeting point received [R14]">
      <bpmn:incoming>f_09</bpmn:incoming>
      <bpmn:outgoing>f_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c_plan_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g_m">
      <bpmn:incoming>f_10</bpmn:incoming>
      <bpmn:incoming>f_17</bpmn:incoming>
      <bpmn:outgoing>f_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_report" name="Report at Meeting Point 15 min before departure [R22-R24]">
      <bpmn:incoming>f_11</bpmn:incoming>
      <bpmn:outgoing>f_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_ok" name="Helper present and train running?">
      <bpmn:incoming>f_12</bpmn:incoming>
      <bpmn:outgoing>f_13</bpmn:outgoing>
      <bpmn:outgoing>f_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_call" name="Call 70 13 14 19 or ask train staff [R30]">
      <bpmn:incoming>f_15</bpmn:incoming>
      <bpmn:outgoing>f_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="c_new" name="New arrangement received">
      <bpmn:incoming>f_16</bpmn:incoming>
      <bpmn:outgoing>f_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c_new_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g_mb">
      <bpmn:incoming>f_13</bpmn:incoming>
      <bpmn:incoming>f_26</bpmn:incoming>
      <bpmn:outgoing>f_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_board" name="Board train with assistance [R03]">
      <bpmn:incoming>f_14</bpmn:incoming>
      <bpmn:outgoing>f_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_travel" name="Travel; companion gives any help on board [R04]">
      <bpmn:incoming>f_18</bpmn:incoming>
      <bpmn:outgoing>f_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_h" name="Helper at the train? [R25]">
      <bpmn:incoming>f_19</bpmn:incoming>
      <bpmn:outgoing>f_20</bpmn:outgoing>
      <bpmn:outgoing>f_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_staff" name="Ask train staff for help off the train [R30]">
      <bpmn:incoming>f_21</bpmn:incoming>
      <bpmn:outgoing>f_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_mh">
      <bpmn:incoming>f_20</bpmn:incoming>
      <bpmn:incoming>f_22</bpmn:incoming>
      <bpmn:outgoing>f_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_alight" name="Alight with assistance [R25, R26]">
      <bpmn:incoming>f_23</bpmn:incoming>
      <bpmn:outgoing>f_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_chg" name="Change of train? [R25]">
      <bpmn:incoming>f_24</bpmn:incoming>
      <bpmn:outgoing>f_25</bpmn:outgoing>
      <bpmn:outgoing>f_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_done" name="Journey completed">
      <bpmn:incoming>f_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_01" sourceRef="s_need" targetRef="g_book" />
    <bpmn:sequenceFlow id="f_02" name="No" sourceRef="g_book" targetRef="t_spont" />
    <bpmn:sequenceFlow id="f_03" sourceRef="t_spont" targetRef="e_spont" />
    <bpmn:sequenceFlow id="f_04" name="Yes" sourceRef="g_book" targetRef="t_book" />
    <bpmn:sequenceFlow id="f_05" sourceRef="t_book" targetRef="c_conf" />
    <bpmn:sequenceFlow id="f_06" sourceRef="c_conf" targetRef="g_evt" />
    <bpmn:sequenceFlow id="f_07" sourceRef="g_evt" targetRef="c_decl" />
    <bpmn:sequenceFlow id="f_08" sourceRef="c_decl" targetRef="e_decl" />
    <bpmn:sequenceFlow id="f_09" sourceRef="g_evt" targetRef="c_plan" />
    <bpmn:sequenceFlow id="f_10" sourceRef="c_plan" targetRef="g_m" />
    <bpmn:sequenceFlow id="f_11" sourceRef="g_m" targetRef="t_report" />
    <bpmn:sequenceFlow id="f_12" sourceRef="t_report" targetRef="g_ok" />
    <bpmn:sequenceFlow id="f_13" name="Yes" sourceRef="g_ok" targetRef="g_mb" />
    <bpmn:sequenceFlow id="f_14" sourceRef="g_mb" targetRef="t_board" />
    <bpmn:sequenceFlow id="f_15" name="No" sourceRef="g_ok" targetRef="t_call" />
    <bpmn:sequenceFlow id="f_16" sourceRef="t_call" targetRef="c_new" />
    <bpmn:sequenceFlow id="f_17" sourceRef="c_new" targetRef="g_m" />
    <bpmn:sequenceFlow id="f_18" sourceRef="t_board" targetRef="t_travel" />
    <bpmn:sequenceFlow id="f_19" sourceRef="t_travel" targetRef="g_h" />
    <bpmn:sequenceFlow id="f_20" name="Yes" sourceRef="g_h" targetRef="g_mh" />
    <bpmn:sequenceFlow id="f_21" name="No" sourceRef="g_h" targetRef="t_staff" />
    <bpmn:sequenceFlow id="f_22" sourceRef="t_staff" targetRef="g_mh" />
    <bpmn:sequenceFlow id="f_23" sourceRef="g_mh" targetRef="t_alight" />
    <bpmn:sequenceFlow id="f_24" sourceRef="t_alight" targetRef="g_chg" />
    <bpmn:sequenceFlow id="f_25" name="No" sourceRef="g_chg" targetRef="e_done" />
    <bpmn:sequenceFlow id="f_26" name="Yes" sourceRef="g_chg" targetRef="g_mb" />
    <bpmn:textAnnotation id="a1"><bpmn:text>Not modelled: free wheelchair seat ticket on InterCity/Lyn [R15]; changes or cancellation until 12 h before [R16]; extended help to taxi rank at 6 stations [R27]; airport hand-over to Falck [R28]; ID card only for ticket discount [R38, assumption].</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="Proc_DSB" name="P5 AS-IS: DSB Handicapservice booking" isExecutable="false">
    <bpmn:startEvent id="s_req" name="Booking request received [R12]">
      <bpmn:outgoing>f_27</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_req_def" />
    </bpmn:startEvent>
    <bpmn:task id="t_reg" name="Register request; send confirmation [R14]">
      <bpmn:incoming>f_27</bpmn:incoming>
      <bpmn:outgoing>f_28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_12" name="At least 12 h before departure? [R09, R10]">
      <bpmn:incoming>f_28</bpmn:incoming>
      <bpmn:outgoing>f_29</bpmn:outgoing>
      <bpmn:outgoing>f_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_late" name="Make reasonable efforts to arrange help [R29]">
      <bpmn:incoming>f_30</bpmn:incoming>
      <bpmn:outgoing>f_31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_poss" name="Help possible?">
      <bpmn:incoming>f_31</bpmn:incoming>
      <bpmn:outgoing>f_32</bpmn:outgoing>
      <bpmn:outgoing>f_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_no" name="Decline sent">
      <bpmn:incoming>f_33</bpmn:incoming>
      <bpmn:messageEventDefinition id="e_no_def" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g_m1">
      <bpmn:incoming>f_29</bpmn:incoming>
      <bpmn:incoming>f_32</bpmn:incoming>
      <bpmn:outgoing>f_34</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_chk" name="Check aid size and stations on route [R17, R18, R39]">
      <bpmn:incoming>f_34</bpmn:incoming>
      <bpmn:outgoing>f_35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_lift" name="Lift or ramp at station? [R19]">
      <bpmn:incoming>f_35</bpmn:incoming>
      <bpmn:outgoing>f_36</bpmn:outgoing>
      <bpmn:outgoing>f_37</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_pl" name="Plan lift or ramp assistance [R19]">
      <bpmn:incoming>f_36</bpmn:incoming>
      <bpmn:outgoing>f_38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_pk" name="Plan taxi to nearest station with lift [R19]">
      <bpmn:incoming>f_37</bpmn:incoming>
      <bpmn:outgoing>f_39</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_m2">
      <bpmn:incoming>f_38</bpmn:incoming>
      <bpmn:incoming>f_39</bpmn:incoming>
      <bpmn:outgoing>f_40</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_ord" name="Order assistance; notify operating company [R13, R40]">
      <bpmn:incoming>f_40</bpmn:incoming>
      <bpmn:outgoing>f_41</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_send" name="Send travel plan with meeting point [R14]">
      <bpmn:incoming>f_41</bpmn:incoming>
      <bpmn:outgoing>f_42</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e_bk" name="Booking completed">
      <bpmn:incoming>f_42</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="s_help" name="Help call or disruption notice received [R30]">
      <bpmn:outgoing>f_45</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_help_def" />
    </bpmn:startEvent>
    <bpmn:task id="t_replan" name="Re-plan: later departure or taxi [R30-R32]">
      <bpmn:incoming>f_45</bpmn:incoming>
      <bpmn:outgoing>f_46</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_inf" name="Inform passenger and provider">
      <bpmn:incoming>f_46</bpmn:incoming>
      <bpmn:outgoing>f_47</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e_re" name="Journey re-planned">
      <bpmn:incoming>f_47</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="s_rep" name="Assistance report received [R33]">
      <bpmn:outgoing>f_43</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_rep_def" />
    </bpmn:startEvent>
    <bpmn:task id="t_rec" name="Record outcome; follow up with operator quarterly [R33]">
      <bpmn:incoming>f_43</bpmn:incoming>
      <bpmn:outgoing>f_44</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e_rec" name="Outcome recorded">
      <bpmn:incoming>f_44</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_27" sourceRef="s_req" targetRef="t_reg" />
    <bpmn:sequenceFlow id="f_28" sourceRef="t_reg" targetRef="g_12" />
    <bpmn:sequenceFlow id="f_29" name="Yes" sourceRef="g_12" targetRef="g_m1" />
    <bpmn:sequenceFlow id="f_30" name="No" sourceRef="g_12" targetRef="t_late" />
    <bpmn:sequenceFlow id="f_31" sourceRef="t_late" targetRef="g_poss" />
    <bpmn:sequenceFlow id="f_32" name="Yes" sourceRef="g_poss" targetRef="g_m1" />
    <bpmn:sequenceFlow id="f_33" name="No" sourceRef="g_poss" targetRef="e_no" />
    <bpmn:sequenceFlow id="f_34" sourceRef="g_m1" targetRef="t_chk" />
    <bpmn:sequenceFlow id="f_35" sourceRef="t_chk" targetRef="g_lift" />
    <bpmn:sequenceFlow id="f_36" name="Yes" sourceRef="g_lift" targetRef="t_pl" />
    <bpmn:sequenceFlow id="f_37" name="No (K station)" sourceRef="g_lift" targetRef="t_pk" />
    <bpmn:sequenceFlow id="f_38" sourceRef="t_pl" targetRef="g_m2" />
    <bpmn:sequenceFlow id="f_39" sourceRef="t_pk" targetRef="g_m2" />
    <bpmn:sequenceFlow id="f_40" sourceRef="g_m2" targetRef="t_ord" />
    <bpmn:sequenceFlow id="f_41" sourceRef="t_ord" targetRef="t_send" />
    <bpmn:sequenceFlow id="f_42" sourceRef="t_send" targetRef="e_bk" />
    <bpmn:sequenceFlow id="f_43" sourceRef="s_rep" targetRef="t_rec" />
    <bpmn:sequenceFlow id="f_44" sourceRef="t_rec" targetRef="e_rec" />
    <bpmn:sequenceFlow id="f_45" sourceRef="s_help" targetRef="t_replan" />
    <bpmn:sequenceFlow id="f_46" sourceRef="t_replan" targetRef="t_inf" />
    <bpmn:sequenceFlow id="f_47" sourceRef="t_inf" targetRef="e_re" />
    <bpmn:textAnnotation id="a2"><bpmn:text>24 h for Swedish Øresund stations and trains to Germany [R10]. EU law allows up to 24 h; DSB uses 12 h since 2016 [R11].</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a2_as" sourceRef="g_12" targetRef="a2" />
    <bpmn:textAnnotation id="a3"><bpmn:text>Limits: 140 x 70 cm and 300 kg incl. passenger; 120 cm on NT/NJ trains, longer aids get a lift taxi [R17, R18].</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="a3_as" sourceRef="t_chk" targetRef="a3" />
    <bpmn:textAnnotation id="a5"><bpmn:text>Providers: station staff or local taxi company; Falck at Copenhagen Airport [R20]. Follow-up outside this model: compensation for damaged aids [R34], complaints [R35], staff training [R36], door-to-door trips booked 72 h ahead [R37].</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="Proc_Prv" name="P5 AS-IS: station assistance" isExecutable="false">
    <bpmn:startEvent id="s_ord" name="New or changed assistance order received [R20]">
      <bpmn:outgoing>f_48</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s_ord_def" />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="c_time" name="Meeting time reached [R22]">
      <bpmn:incoming>f_48</bpmn:incoming>
      <bpmn:outgoing>f_49</bpmn:outgoing>
      <bpmn:timerEventDefinition id="c_time_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t_meet" name="Meet passenger at Meeting Point or arriving train [R23]">
      <bpmn:incoming>f_49</bpmn:incoming>
      <bpmn:outgoing>f_50</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_lift" name="Escort; operate lift or ramp; help with 1 item max 20 kg [R03, R05, R17]">
      <bpmn:incoming>f_51</bpmn:incoming>
      <bpmn:outgoing>f_53</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g_show" name="Passenger at Meeting Point? [R24]">
      <bpmn:incoming>f_50</bpmn:incoming>
      <bpmn:outgoing>f_51</bpmn:outgoing>
      <bpmn:outgoing>f_52</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_mr">
      <bpmn:incoming>f_52</bpmn:incoming>
      <bpmn:incoming>f_53</bpmn:incoming>
      <bpmn:outgoing>f_54</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_rep" name="Report assistance delivered or failed to DSB [R33]">
      <bpmn:incoming>f_54</bpmn:incoming>
      <bpmn:outgoing>f_55</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e_del" name="Order closed">
      <bpmn:incoming>f_55</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f_48" sourceRef="s_ord" targetRef="c_time" />
    <bpmn:sequenceFlow id="f_49" sourceRef="c_time" targetRef="t_meet" />
    <bpmn:sequenceFlow id="f_50" sourceRef="t_meet" targetRef="g_show" />
    <bpmn:sequenceFlow id="f_51" name="Yes" sourceRef="g_show" targetRef="t_lift" />
    <bpmn:sequenceFlow id="f_52" name="No (no-show)" sourceRef="g_show" targetRef="g_mr" />
    <bpmn:sequenceFlow id="f_53" sourceRef="t_lift" targetRef="g_mr" />
    <bpmn:sequenceFlow id="f_54" sourceRef="g_mr" targetRef="t_rep" />
    <bpmn:sequenceFlow id="f_55" sourceRef="t_rep" targetRef="e_del" />
    <bpmn:textAnnotation id="a4"><bpmn:text>Runs once per station: departure, each change, arrival [R25, R26]. At K stations the provider drives the passenger to the nearest station with a lift [R19]. Free of charge and offered whenever trains run [R02, R21].</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
