# Claim emails from the results page (service/rejsegaranti/mailing.py). Copy to /etc/rejsegaranti/mail.env on
# the server (mode 600, owned by root), fill in the password, and restart rejsegaranti-bridge.
# Leave SMTP_HOST empty to switch the mailing list off (the page then has no sign-up form).
#
# iCloud Mail: the password is an app-specific password from https://account.apple.com (Sign-In and Security >
# App-Specific Passwords), not your Apple ID password. SMTP_USER is your full iCloud address.
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The From address; must be your iCloud address or an alias of it. Default: SMTP_USER
MAIL_FROM=
