      <bpmndi:BPMNShape id="Task_RejectNotCovered_di" bpmnElement="Task_RejectNotCovered"><dc:Bounds x="1155" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CoveredJoin_di" bpmnElement="Gateway_CoveredJoin" isMarkerVisible="true"><dc:Bounds x="1405" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1375" y="289" width="110" height="40" /></bpmndi:BPMNLabel>
