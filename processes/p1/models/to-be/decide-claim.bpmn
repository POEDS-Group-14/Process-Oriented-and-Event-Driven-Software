<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_decide-claim" targetNamespace="http://poeds-group-14.dtu.dk/rejsegaranti" exporter="tools/build_to_be_bpmn.py" exporterVersion="1.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:documentation>Author: Liam Palmqvist. TO-BE of process 1, the Movia travel guarantee. Generated by tools/build_to_be_bpmn.py.</bpmn:documentation>
    <bpmn:participant id="Participant_tobe-decide-claim" name="Movia: decide claim and pay out (once per claim)" processRef="tobe-decide-claim" />
  </bpmn:collaboration>
  <bpmn:message id="Message_ClaimReceived" name="ClaimReceived" />
  <bpmn:process id="tobe-decide-claim" name="Movia: decide claim and pay out (once per claim)" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="Start_Claim" name="Claim submitted">
      <bpmn:outgoing>Flow_Start_Claim_Task_Validity</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_ClaimReceived" messageRef="Message_ClaimReceived" />
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="Task_Validity" name="Check claim validity" camunda:decisionRef="ToBe_ClaimValid">
      <bpmn:extensionElements><camunda:inputOutput><camunda:outputParameter name="claimValid">${decisionResult.getSingleResult().claimValid}</camunda:outputParameter><camunda:outputParameter name="claimReason">${decisionResult.getSingleResult().claimReason}</camunda:outputParameter></camunda:inputOutput></bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Claim_Task_Validity</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Validity_Gateway_Valid</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Valid" name="Claim valid?">
      <bpmn:incoming>Flow_Task_Validity_Gateway_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Valid_Task_Match</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_Valid_Task_RejectInvalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Match" name="Match claim to disruption" camunda:type="external" camunda:topic="tb-match-claim">
      <bpmn:incoming>Flow_Gateway_Valid_Task_Match</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Match_Task_Guarantee</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_Guarantee" name="Decide travel guarantee" camunda:decisionRef="ToBe_TravelGuarantee">
      <bpmn:extensionElements><camunda:inputOutput><camunda:outputParameter name="covered">${decisionResult.getSingleResult().covered}</camunda:outputParameter><camunda:outputParameter name="guaranteeReason">${decisionResult.getSingleResult().reason}</camunda:outputParameter></camunda:inputOutput></bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_Match_Task_Guarantee</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Guarantee_Gateway_Covered</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Covered" name="Covered?">
      <bpmn:incoming>Flow_Task_Guarantee_Gateway_Covered</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Covered_Task_Refund</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_Covered_Task_RejectNotCovered</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_Refund" name="Calculate refund" camunda:decisionRef="ToBe_Refund">
      <bpmn:extensionElements><camunda:inputOutput><camunda:outputParameter name="refundDkk">${decisionResult.getSingleResult().refundDkk}</camunda:outputParameter></camunda:inputOutput></bpmn:extensionElements>
      <bpmn:incoming>Flow_Gateway_Covered_Task_Refund</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Refund_Task_PayOut</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Task_PayOut" name="Pay out refund" camunda:type="external" camunda:topic="tb-pay-out">
      <bpmn:incoming>Flow_Task_Refund_Task_PayOut</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_PayOut_Gateway_CoveredJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RejectNotCovered" name="Reject claim (not covered)" camunda:type="external" camunda:topic="tb-reject">
      <bpmn:incoming>Flow_Gateway_Covered_Task_RejectNotCovered</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_RejectNotCovered_Gateway_CoveredJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_CoveredJoin">
      <bpmn:incoming>Flow_Task_PayOut_Gateway_CoveredJoin</bpmn:incoming>
      <bpmn:incoming>Flow_Task_RejectNotCovered_Gateway_CoveredJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_CoveredJoin_Gateway_ValidJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RejectInvalid" name="Reject claim (invalid)" camunda:type="external" camunda:topic="tb-reject">
      <bpmn:incoming>Flow_Gateway_Valid_Task_RejectInvalid</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_RejectInvalid_Gateway_ValidJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ValidJoin">
      <bpmn:incoming>Flow_Gateway_CoveredJoin_Gateway_ValidJoin</bpmn:incoming>
      <bpmn:incoming>Flow_Task_RejectInvalid_Gateway_ValidJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_ValidJoin_Task_Send</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Send" name="Send decision to passenger" camunda:type="external" camunda:topic="tb-send-decision">
      <bpmn:incoming>Flow_Gateway_ValidJoin_Task_Send</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Send_End_Decided</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Decided" name="Claim decided">
      <bpmn:incoming>Flow_Task_Send_End_Decided</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Claim_Task_Validity" sourceRef="Start_Claim" targetRef="Task_Validity" />
    <bpmn:sequenceFlow id="Flow_Task_Validity_Gateway_Valid" sourceRef="Task_Validity" targetRef="Gateway_Valid" />
    <bpmn:sequenceFlow id="Flow_Gateway_Valid_Task_Match" name="yes" sourceRef="Gateway_Valid" targetRef="Task_Match">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${claimValid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_Valid_Task_RejectInvalid" name="no" sourceRef="Gateway_Valid" targetRef="Task_RejectInvalid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!claimValid}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Task_Match_Task_Guarantee" sourceRef="Task_Match" targetRef="Task_Guarantee" />
    <bpmn:sequenceFlow id="Flow_Task_Guarantee_Gateway_Covered" sourceRef="Task_Guarantee" targetRef="Gateway_Covered" />
    <bpmn:sequenceFlow id="Flow_Gateway_Covered_Task_Refund" name="yes" sourceRef="Gateway_Covered" targetRef="Task_Refund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${covered}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_Covered_Task_RejectNotCovered" name="no" sourceRef="Gateway_Covered" targetRef="Task_RejectNotCovered">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!covered}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Task_Refund_Task_PayOut" sourceRef="Task_Refund" targetRef="Task_PayOut" />
    <bpmn:sequenceFlow id="Flow_Task_PayOut_Gateway_CoveredJoin" sourceRef="Task_PayOut" targetRef="Gateway_CoveredJoin" />
    <bpmn:sequenceFlow id="Flow_Task_RejectNotCovered_Gateway_CoveredJoin" sourceRef="Task_RejectNotCovered" targetRef="Gateway_CoveredJoin" />
    <bpmn:sequenceFlow id="Flow_Gateway_CoveredJoin_Gateway_ValidJoin" sourceRef="Gateway_CoveredJoin" targetRef="Gateway_ValidJoin" />
    <bpmn:sequenceFlow id="Flow_Task_RejectInvalid_Gateway_ValidJoin" sourceRef="Task_RejectInvalid" targetRef="Gateway_ValidJoin" />
    <bpmn:sequenceFlow id="Flow_Gateway_ValidJoin_Task_Send" sourceRef="Gateway_ValidJoin" targetRef="Task_Send" />
    <bpmn:sequenceFlow id="Flow_Task_Send_End_Decided" sourceRef="Task_Send" targetRef="End_Decided" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
