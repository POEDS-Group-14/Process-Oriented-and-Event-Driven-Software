      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ValidJoin_di" bpmnElement="Gateway_ValidJoin" isMarkerVisible="true"><dc:Bounds x="1555" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1525" y="289" width="110" height="40" /></bpmndi:BPMNLabel>
