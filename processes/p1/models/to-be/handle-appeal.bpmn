<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_handle-appeal" targetNamespace="http://poeds-group-14.dtu.dk/rejsegaranti" exporter="tools/build_to_be_bpmn.py" exporterVersion="1.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:documentation>Author: Liam Palmqvist. TO-BE of process 1, the Movia travel guarantee. Generated by tools/build_to_be_bpmn.py.</bpmn:documentation>
    <bpmn:participant id="Participant_tobe-handle-appeal" name="Movia: handle appeal (once per appeal)" processRef="tobe-handle-appeal" />
  </bpmn:collaboration>
  <bpmn:message id="Message_AppealSubmitted" name="AppealSubmitted" />
  <bpmn:process id="tobe-handle-appeal" name="Movia: handle appeal (once per appeal)" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_tobe-handle-appeal">
      <bpmn:lane id="Lane_System" name="Claims system">
        <bpmn:flowNodeRef>Start_Appeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Retrieve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PayOut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_UpheldJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendAppeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Appeal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CaseWorker" name="Case worker">
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Upheld</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Appeal" name="Appeal received">
      <bpmn:outgoing>Flow_Start_Appeal_Task_Retrieve</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_AppealSubmitted" messageRef="Message_AppealSubmitted" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Retrieve" name="Retrieve claim and evidence" camunda:type="external" camunda:topic="tb-retrieve-claim">
      <bpmn:incoming>Flow_Start_Appeal_Task_Retrieve</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Retrieve_Task_Review</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Review" name="Review appeal" camunda:candidateGroups="caseworker">
      <bpmn:extensionElements><camunda:formData><camunda:formField id="upheld" label="Appeal upheld (pay the refund)" type="boolean" /><camunda:formField id="reviewNote" label="Reason for the decision" type="string" /></camunda:formData></bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_Retrieve_Task_Review</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Review_Gateway_Upheld</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Upheld" name="Appeal upheld?">
      <bpmn:incoming>Flow_Task_Review_Gateway_Upheld</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Upheld_Task_Refund</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_Upheld_Gateway_UpheldJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_Refund" name="Calculate refund" camunda:decisionRef="ToBe_Refund">
      <bpmn:extensionElements><camunda:inputOutput><camunda:outputParameter name="refundDkk">${decisionResult.getSingleResult().refundDkk}</camunda:outputParameter></camunda:inputOutput></bpmn:extensionElements>
      <bpmn:incoming>Flow_Gateway_Upheld_Task_Refund</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Refund_Task_PayOut</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Task_PayOut" name="Pay out refund" camunda:type="external" camunda:topic="tb-pay-out">
      <bpmn:incoming>Flow_Task_Refund_Task_PayOut</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_PayOut_Gateway_UpheldJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_UpheldJoin">
      <bpmn:incoming>Flow_Gateway_Upheld_Gateway_UpheldJoin</bpmn:incoming>
      <bpmn:incoming>Flow_Task_PayOut_Gateway_UpheldJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_UpheldJoin_Task_SendAppeal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SendAppeal" name="Send appeal decision" camunda:type="external" camunda:topic="tb-send-appeal-decision">
      <bpmn:incoming>Flow_Gateway_UpheldJoin_Task_SendAppeal</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_SendAppeal_End_Appeal</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Appeal" name="Appeal decided">
      <bpmn:incoming>Flow_Task_SendAppeal_End_Appeal</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Appeal_Task_Retrieve" sourceRef="Start_Appeal" targetRef="Task_Retrieve" />
    <bpmn:sequenceFlow id="Flow_Task_Retrieve_Task_Review" sourceRef="Task_Retrieve" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_Task_Review_Gateway_Upheld" sourceRef="Task_Review" targetRef="Gateway_Upheld" />
    <bpmn:sequenceFlow id="Flow_Gateway_Upheld_Task_Refund" name="yes" sourceRef="Gateway_Upheld" targetRef="Task_Refund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${upheld}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_Upheld_Gateway_UpheldJoin" name="no" sourceRef="Gateway_Upheld" targetRef="Gateway_UpheldJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!upheld}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Task_Refund_Task_PayOut" sourceRef="Task_Refund" targetRef="Task_PayOut" />
    <bpmn:sequenceFlow id="Flow_Task_PayOut_Gateway_UpheldJoin" sourceRef="Task_PayOut" targetRef="Gateway_UpheldJoin" />
    <bpmn:sequenceFlow id="Flow_Gateway_UpheldJoin_Task_SendAppeal" sourceRef="Gateway_UpheldJoin" targetRef="Task_SendAppeal" />
    <bpmn:sequenceFlow id="Flow_Task_SendAppeal_End_Appeal" sourceRef="Task_SendAppeal" targetRef="End_Appeal" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_tobe-handle-appeal_di" bpmnElement="Participant_tobe-handle-appeal" isHorizontal="true"><dc:Bounds x="100" y="60" width="1420" height="270" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true"><dc:Bounds x="130" y="60" width="1390" height="135.0" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CaseWorker_di" bpmnElement="Lane_CaseWorker" isHorizontal="true"><dc:Bounds x="130" y="195.0" width="1390" height="135.0" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Appeal_di" bpmnElement="Start_Appeal"><dc:Bounds x="212" y="112" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="175" y="152" width="110" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Retrieve_di" bpmnElement="Task_Retrieve"><dc:Bounds x="330" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review"><dc:Bounds x="480" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Upheld_di" bpmnElement="Gateway_Upheld" isMarkerVisible="true"><dc:Bounds x="655" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="625" y="289" width="110" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Refund_di" bpmnElement="Task_Refund"><dc:Bounds x="780" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PayOut_di" bpmnElement="Task_PayOut"><dc:Bounds x="930" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_UpheldJoin_di" bpmnElement="Gateway_UpheldJoin" isMarkerVisible="true"><dc:Bounds x="1105" y="105" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1075" y="159" width="110" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendAppeal_di" bpmnElement="Task_SendAppeal"><dc:Bounds x="1230" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Appeal_di" bpmnElement="End_Appeal"><dc:Bounds x="1412" y="112" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1375" y="152" width="110" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Appeal_Task_Retrieve_di" bpmnElement="Flow_Start_Appeal_Task_Retrieve">
        <di:waypoint x="248" y="130" />
        <di:waypoint x="330" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task_Retrieve_Task_Review_di" bpmnElement="Flow_Task_Retrieve_Task_Review">
        <di:waypoint x="430" y="130" />
        <di:waypoint x="455" y="130" />
        <di:waypoint x="455" y="260" />
        <di:waypoint x="480" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task_Review_Gateway_Upheld_di" bpmnElement="Flow_Task_Review_Gateway_Upheld">
        <di:waypoint x="580" y="260" />
        <di:waypoint x="655" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_Upheld_Task_Refund_di" bpmnElement="Flow_Gateway_Upheld_Task_Refund">
        <di:waypoint x="680" y="235" />
        <di:waypoint x="680" y="130" />
        <di:waypoint x="780" y="130" />
        <bpmndi:BPMNLabel><dc:Bounds x="686" y="176" width="26" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_Upheld_Gateway_UpheldJoin_di" bpmnElement="Flow_Gateway_Upheld_Gateway_UpheldJoin">
        <di:waypoint x="705" y="260" />
        <di:waypoint x="1130" y="260" />
        <di:waypoint x="1130" y="155" />
        <bpmndi:BPMNLabel><dc:Bounds x="709" y="243" width="26" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task_Refund_Task_PayOut_di" bpmnElement="Flow_Task_Refund_Task_PayOut">
        <di:waypoint x="880" y="130" />
        <di:waypoint x="930" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task_PayOut_Gateway_UpheldJoin_di" bpmnElement="Flow_Task_PayOut_Gateway_UpheldJoin">
        <di:waypoint x="1030" y="130" />
        <di:waypoint x="1105" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_UpheldJoin_Task_SendAppeal_di" bpmnElement="Flow_Gateway_UpheldJoin_Task_SendAppeal">
        <di:waypoint x="1155" y="130" />
        <di:waypoint x="1230" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task_SendAppeal_End_Appeal_di" bpmnElement="Flow_Task_SendAppeal_End_Appeal">
        <di:waypoint x="1330" y="130" />
        <di:waypoint x="1412" y="130" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
