  <bpmn:collaboration id="Collaboration_1">
    <bpmn:documentation>Author: Liam Palmqvist. TO-BE of process 1, the Movia travel guarantee. Generated by tools/build_to_be_bpmn.py.</bpmn:documentation>
    <bpmn:participant id="Participant_passenger-journey" name="Passenger" processRef="passenger-journey" />
    <bpmn:participant id="Participant_Movia" name="Movia customer service" />
    <bpmn:messageFlow id="Msg_Notice" name="eligibility notice" sourceRef="Participant_Movia" targetRef="Task_ReadNotice" />
    <bpmn:messageFlow id="Msg_Claim" name="claim" sourceRef="Task_Submit" targetRef="Participant_Movia" />
    <bpmn:messageFlow id="Msg_Decision" name="decision" sourceRef="Participant_Movia" targetRef="Task_Decision" />
    <bpmn:messageFlow id="Msg_Appeal" name="appeal" sourceRef="Task_Appeal" targetRef="Participant_Movia" />
    <bpmn:messageFlow id="Msg_AppealDecision" name="appeal decision" sourceRef="Participant_Movia" targetRef="Task_AppealDecision" />
  </bpmn:collaboration>
  <bpmn:process id="passenger-journey" name="Passenger" isExecutable="false">
    <bpmn:startEvent id="Start_Disrupted" name="Trip disrupted">
      <bpmn:outgoing>Flow_Start_Disrupted_Gateway_Notified</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_Notified" name="Notified by Movia?">
      <bpmn:incoming>Flow_Start_Disrupted_Gateway_Notified</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Notified_Task_ReadNotice</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_Notified_Gateway_NotifiedJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ReadNotice" name="Read eligibility notice">
      <bpmn:incoming>Flow_Gateway_Notified_Task_ReadNotice</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_ReadNotice_Gateway_NotifiedJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_NotifiedJoin">
      <bpmn:incoming>Flow_Gateway_Notified_Gateway_NotifiedJoin</bpmn:incoming>
      <bpmn:incoming>Flow_Task_ReadNotice_Gateway_NotifiedJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_NotifiedJoin_Task_Taxi</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Taxi" name="Take a taxi">
      <bpmn:incoming>Flow_Gateway_NotifiedJoin_Task_Taxi</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Taxi_Task_Submit</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Submit" name="Submit claim with receipt">
      <bpmn:incoming>Flow_Task_Taxi_Task_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Submit_Task_Decision</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Decision" name="Receive decision">
      <bpmn:incoming>Flow_Task_Submit_Task_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Decision_Gateway_Accept</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Accept" name="Accept the decision?">
      <bpmn:incoming>Flow_Task_Decision_Gateway_Accept</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Accept_Task_Appeal</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_Accept_Gateway_AcceptJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Appeal" name="Submit appeal">
      <bpmn:incoming>Flow_Gateway_Accept_Task_Appeal</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Appeal_Task_AppealDecision</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AppealDecision" name="Receive appeal decision">
      <bpmn:incoming>Flow_Task_Appeal_Task_AppealDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_AppealDecision_Gateway_AcceptJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_AcceptJoin">
      <bpmn:incoming>Flow_Task_AppealDecision_Gateway_AcceptJoin</bpmn:incoming>
      <bpmn:incoming>Flow_Gateway_Accept_Gateway_AcceptJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_AcceptJoin_End_Settled</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Settled" name="Claim settled">
      <bpmn:incoming>Flow_Gateway_AcceptJoin_End_Settled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Disrupted_Gateway_Notified" sourceRef="Start_Disrupted" targetRef="Gateway_Notified" />
    <bpmn:sequenceFlow id="Flow_Gateway_Notified_Task_ReadNotice" name="yes" sourceRef="Gateway_Notified" targetRef="Task_ReadNotice" />
