    <bpmn:sequenceFlow id="Flow_Task_Decision_Gateway_Accept" sourceRef="Task_Decision" targetRef="Gateway_Accept" />
    <bpmn:sequenceFlow id="Flow_Gateway_Accept_Task_Appeal" name="no" sourceRef="Gateway_Accept" targetRef="Task_Appeal" />
    <bpmn:sequenceFlow id="Flow_Task_Appeal_Task_AppealDecision" sourceRef="Task_Appeal" targetRef="Task_AppealDecision" />
    <bpmn:sequenceFlow id="Flow_Task_AppealDecision_Gateway_AcceptJoin" sourceRef="Task_AppealDecision" targetRef="Gateway_AcceptJoin" />
    <bpmn:sequenceFlow id="Flow_Gateway_Accept_Gateway_AcceptJoin" name="yes" sourceRef="Gateway_Accept" targetRef="Gateway_AcceptJoin" />
    <bpmn:sequenceFlow id="Flow_Gateway_AcceptJoin_End_Settled" sourceRef="Gateway_AcceptJoin" targetRef="End_Settled" />
  </bpmn:process>
