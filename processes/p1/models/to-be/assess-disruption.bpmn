<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_assess-disruption" targetNamespace="http://poeds-group-14.dtu.dk/rejsegaranti" exporter="tools/build_to_be_bpmn.py" exporterVersion="1.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:documentation>Author: Liam Palmqvist. TO-BE of process 1, the Movia travel guarantee. Generated by tools/build_to_be_bpmn.py.</bpmn:documentation>
    <bpmn:participant id="Participant_tobe-assess-disruption" name="Movia: assess disruption (once per delay)" processRef="tobe-assess-disruption" />
  </bpmn:collaboration>
  <bpmn:message id="Message_DelayReported" name="DelayReported" />
  <bpmn:process id="tobe-assess-disruption" name="Movia: assess disruption (once per delay)" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="Start_Delay" name="Delay reported">
      <bpmn:outgoing>Flow_Start_Delay_Task_Collect</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_DelayReported" messageRef="Message_DelayReported" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Collect" name="Collect disruption data" camunda:type="external" camunda:topic="tb-collect-disruption">
      <bpmn:incoming>Flow_Start_Delay_Task_Collect</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Collect_Task_Exclusion</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_Exclusion" name="Decide exclusion" camunda:decisionRef="ToBe_Exclusion">
      <bpmn:extensionElements><camunda:inputOutput><camunda:outputParameter name="exclusion">${decisionResult.getSingleResult().exclusion}</camunda:outputParameter></camunda:inputOutput></bpmn:extensionElements>
      <bpmn:incoming>Flow_Task_Collect_Task_Exclusion</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Exclusion_Gateway_CanApply</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_CanApply" name="Guarantee can apply?">
      <bpmn:incoming>Flow_Task_Exclusion_Gateway_CanApply</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_CanApply_Task_Notify</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_CanApply_Gateway_CanApplyJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Notify" name="Notify affected passengers" camunda:type="external" camunda:topic="tb-notify-passengers">
      <bpmn:incoming>Flow_Gateway_CanApply_Task_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Notify_Gateway_CanApplyJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_CanApplyJoin">
      <bpmn:incoming>Flow_Gateway_CanApply_Gateway_CanApplyJoin</bpmn:incoming>
      <bpmn:incoming>Flow_Task_Notify_Gateway_CanApplyJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_CanApplyJoin_Task_Publish</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Publish" name="Publish disruption assessment" camunda:type="external" camunda:topic="tb-publish-assessment">
      <bpmn:incoming>Flow_Gateway_CanApplyJoin_Task_Publish</bpmn:incoming>
      <bpmn:outgoing>Flow_Task_Publish_End_Assessed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Assessed" name="Disruption assessed">
      <bpmn:incoming>Flow_Task_Publish_End_Assessed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Delay_Task_Collect" sourceRef="Start_Delay" targetRef="Task_Collect" />
    <bpmn:sequenceFlow id="Flow_Task_Collect_Task_Exclusion" sourceRef="Task_Collect" targetRef="Task_Exclusion" />
    <bpmn:sequenceFlow id="Flow_Task_Exclusion_Gateway_CanApply" sourceRef="Task_Exclusion" targetRef="Gateway_CanApply" />
    <bpmn:sequenceFlow id="Flow_Gateway_CanApply_Task_Notify" name="yes" sourceRef="Gateway_CanApply" targetRef="Task_Notify">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${exclusion == &quot;none&quot;}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_CanApply_Gateway_CanApplyJoin" name="no (excluded)" sourceRef="Gateway_CanApply" targetRef="Gateway_CanApplyJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${exclusion != &quot;none&quot;}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Task_Notify_Gateway_CanApplyJoin" sourceRef="Task_Notify" targetRef="Gateway_CanApplyJoin" />
    <bpmn:sequenceFlow id="Flow_Gateway_CanApplyJoin_Task_Publish" sourceRef="Gateway_CanApplyJoin" targetRef="Task_Publish" />
    <bpmn:sequenceFlow id="Flow_Task_Publish_End_Assessed" sourceRef="Task_Publish" targetRef="End_Assessed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_tobe-assess-disruption_di" bpmnElement="Participant_tobe-assess-disruption" isHorizontal="true"><dc:Bounds x="100" y="60" width="1270" height="270" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Delay_di" bpmnElement="Start_Delay"><dc:Bounds x="212" y="112" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="175" y="152" width="110" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Collect_di" bpmnElement="Task_Collect"><dc:Bounds x="330" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Exclusion_di" bpmnElement="Task_Exclusion"><dc:Bounds x="480" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CanApply_di" bpmnElement="Gateway_CanApply" isMarkerVisible="true"><dc:Bounds x="655" y="105" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="625" y="73" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Notify_di" bpmnElement="Task_Notify"><dc:Bounds x="780" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CanApplyJoin_di" bpmnElement="Gateway_CanApplyJoin" isMarkerVisible="true"><dc:Bounds x="955" y="105" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="925" y="159" width="110" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Publish_di" bpmnElement="Task_Publish"><dc:Bounds x="1080" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Assessed_di" bpmnElement="End_Assessed"><dc:Bounds x="1262" y="112" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1225" y="152" width="110" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Delay_Task_Collect_di" bpmnElement="Flow_Start_Delay_Task_Collect">
        <di:waypoint x="248" y="130" />
        <di:waypoint x="330" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task_Collect_Task_Exclusion_di" bpmnElement="Flow_Task_Collect_Task_Exclusion">
        <di:waypoint x="430" y="130" />
        <di:waypoint x="480" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task_Exclusion_Gateway_CanApply_di" bpmnElement="Flow_Task_Exclusion_Gateway_CanApply">
        <di:waypoint x="580" y="130" />
        <di:waypoint x="655" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_CanApply_Task_Notify_di" bpmnElement="Flow_Gateway_CanApply_Task_Notify">
        <di:waypoint x="705" y="130" />
        <di:waypoint x="780" y="130" />
        <bpmndi:BPMNLabel><dc:Bounds x="709" y="113" width="26" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_CanApply_Gateway_CanApplyJoin_di" bpmnElement="Flow_Gateway_CanApply_Gateway_CanApplyJoin">
        <di:waypoint x="680" y="155" />
        <di:waypoint x="680" y="260" />
        <di:waypoint x="980" y="260" />
        <di:waypoint x="980" y="155" />
        <bpmndi:BPMNLabel><dc:Bounds x="686" y="200" width="91" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task_Notify_Gateway_CanApplyJoin_di" bpmnElement="Flow_Task_Notify_Gateway_CanApplyJoin">
        <di:waypoint x="880" y="130" />
        <di:waypoint x="955" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_CanApplyJoin_Task_Publish_di" bpmnElement="Flow_Gateway_CanApplyJoin_Task_Publish">
        <di:waypoint x="1005" y="130" />
        <di:waypoint x="1080" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Task_Publish_End_Assessed_di" bpmnElement="Flow_Task_Publish_End_Assessed">
        <di:waypoint x="1180" y="130" />
        <di:waypoint x="1262" y="130" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
