  <bpmn:collaboration id="Collaboration_1">
    <bpmn:documentation>Author: Liam Palmqvist. TO-BE of process 1, the Movia travel guarantee. Generated by tools/build_to_be_bpmn.py.</bpmn:documentation>
    <bpmn:participant id="Participant_Passenger" name="Passenger (passenger journey)" />
    <bpmn:participant id="Participant_Assess" name="Movia: assess disruption" />
    <bpmn:participant id="Participant_Decide" name="Movia: decide claim and pay out" />
    <bpmn:participant id="Participant_Appeal" name="Movia: handle appeal" />
    <bpmn:participant id="Participant_Monitor" name="Delay monitor (CEP) and recorder" />
    <bpmn:messageFlow id="Msg_Delay" name="delay situation" sourceRef="Participant_Monitor" targetRef="Participant_Assess" />
    <bpmn:messageFlow id="Msg_Assessment" name="disruption assessment" sourceRef="Participant_Assess" targetRef="Participant_Monitor" />
    <bpmn:messageFlow id="Msg_Notice" name="eligibility notice" sourceRef="Participant_Assess" targetRef="Participant_Passenger" />
    <bpmn:messageFlow id="Msg_Claim" name="claim with receipt" sourceRef="Participant_Passenger" targetRef="Participant_Decide" />
    <bpmn:messageFlow id="Msg_Decision" name="decision" sourceRef="Participant_Decide" targetRef="Participant_Passenger" />
    <bpmn:messageFlow id="Msg_Exclusion" name="exclusion" sourceRef="Participant_Assess" targetRef="Participant_Decide" />
    <bpmn:messageFlow id="Msg_Outcome" name="claim outcome" sourceRef="Participant_Decide" targetRef="Participant_Monitor" />
    <bpmn:messageFlow id="Msg_Appeal" name="appeal" sourceRef="Participant_Passenger" targetRef="Participant_Appeal" />
    <bpmn:messageFlow id="Msg_AppealDecision" name="appeal decision" sourceRef="Participant_Appeal" targetRef="Participant_Passenger" />
  </bpmn:collaboration>
