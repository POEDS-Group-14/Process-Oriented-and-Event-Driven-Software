<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_rejsegaranti_as_is" targetNamespace="http://poeds-group-14.dtu.dk/rejsegaranti" exporter="tools/build_bpmn.py" exporterVersion="1.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:documentation>Rejsegaranti AS-IS, author Liam Palmqvist</bpmn:documentation>
    <bpmn:participant id="Participant_rejsegaranti-as-is-passenger" name="Passenger" processRef="rejsegaranti-as-is-passenger" />
    <bpmn:participant id="Participant_rejsegaranti-as-is-customer-service" name="Hovedstadens Letbane, customer service" processRef="rejsegaranti-as-is-customer-service" />
    <bpmn:messageFlow id="MF_Form" name="claim form + receipt" sourceRef="P_Form" targetRef="S_Start" />
    <bpmn:messageFlow id="MF_Ask" name="request for details" sourceRef="S_Ask" targetRef="P_Ask" />
    <bpmn:messageFlow id="MF_Details" name="missing details" sourceRef="P_Send" targetRef="S_Details" />
    <bpmn:messageFlow id="MF_Decision" name="refund or rejection" sourceRef="S_Send" targetRef="P_Decision" />
    <bpmn:textAnnotation id="Annotation_Author"><bpmn:text>Process 1 Rejsegaranti, AS-IS (manual handling today). Author: Liam Palmqvist. Rules: dinletbane.dk/da/kontakt-og-kundeservice/rejsegaranti</bpmn:text></bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="rejsegaranti-as-is-passenger" name="Passenger" isExecutable="false">
    <bpmn:startEvent id="P_Start" name="Line L 30+ minutes late">
      <bpmn:outgoing>Flow_P_Start_P_Taxi</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P_Taxi" name="Take taxi, shared bike or shared car">
      <bpmn:incoming>Flow_P_Start_P_Taxi</bpmn:incoming>
      <bpmn:outgoing>Flow_P_Taxi_P_Receipt</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P_Receipt" name="Pay and keep the receipt">
      <bpmn:incoming>Flow_P_Taxi_P_Receipt</bpmn:incoming>
      <bpmn:outgoing>Flow_P_Receipt_P_Form</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="P_Form" name="Fill in rejsegaranti form with receipt">
      <bpmn:incoming>Flow_P_Receipt_P_Form</bpmn:incoming>
      <bpmn:outgoing>Flow_P_Form_P_Merge</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="P_Merge">
      <bpmn:incoming>Flow_P_Form_P_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_P_Send_P_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_P_Merge_P_Wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="P_Wait">
      <bpmn:incoming>Flow_P_Merge_P_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_P_Wait_P_Ask</bpmn:outgoing>
      <bpmn:outgoing>Flow_P_Wait_P_Decision</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="P_Ask" name="Asked for missing details">
      <bpmn:incoming>Flow_P_Wait_P_Ask</bpmn:incoming>
      <bpmn:outgoing>Flow_P_Ask_P_Send</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P_AskDef" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="P_Send" name="Send missing receipt details">
      <bpmn:incoming>Flow_P_Ask_P_Send</bpmn:incoming>
      <bpmn:outgoing>Flow_P_Send_P_Merge</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="P_Decision" name="Decision received">
      <bpmn:incoming>Flow_P_Wait_P_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_P_Decision_P_End</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P_DecisionDef" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="P_End" name="Claim settled">
      <bpmn:incoming>Flow_P_Decision_P_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_P_Start_P_Taxi" sourceRef="P_Start" targetRef="P_Taxi" />
    <bpmn:sequenceFlow id="Flow_P_Taxi_P_Receipt" sourceRef="P_Taxi" targetRef="P_Receipt" />
    <bpmn:sequenceFlow id="Flow_P_Receipt_P_Form" sourceRef="P_Receipt" targetRef="P_Form" />
    <bpmn:sequenceFlow id="Flow_P_Form_P_Merge" sourceRef="P_Form" targetRef="P_Merge" />
    <bpmn:sequenceFlow id="Flow_P_Merge_P_Wait" sourceRef="P_Merge" targetRef="P_Wait" />
    <bpmn:sequenceFlow id="Flow_P_Wait_P_Ask" sourceRef="P_Wait" targetRef="P_Ask" />
    <bpmn:sequenceFlow id="Flow_P_Wait_P_Decision" sourceRef="P_Wait" targetRef="P_Decision" />
    <bpmn:sequenceFlow id="Flow_P_Ask_P_Send" sourceRef="P_Ask" targetRef="P_Send" />
    <bpmn:sequenceFlow id="Flow_P_Send_P_Merge" sourceRef="P_Send" targetRef="P_Merge" />
    <bpmn:sequenceFlow id="Flow_P_Decision_P_End" sourceRef="P_Decision" targetRef="P_End" />
  </bpmn:process>
  <bpmn:process id="rejsegaranti-as-is-customer-service" name="Hovedstadens Letbane, customer service" isExecutable="false">
    <bpmn:startEvent id="S_Start" name="Claim received">
      <bpmn:outgoing>Flow_S_Start_S_Delay</bpmn:outgoing>
      <bpmn:messageEventDefinition id="S_StartDef" />
    </bpmn:startEvent>
    <bpmn:userTask id="S_Delay" name="Look up the delay in the operations log">
      <bpmn:incoming>Flow_S_Start_S_Delay</bpmn:incoming>
      <bpmn:outgoing>Flow_S_Delay_S_GwDelay</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="S_GwDelay" name="Delay of 30+ minutes?" default="S_f_delay_yes">
      <bpmn:incoming>Flow_S_Delay_S_GwDelay</bpmn:incoming>
      <bpmn:outgoing>S_f_delay_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_S_GwDelay_S_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="S_Notice" name="Check notices of planned changes">
      <bpmn:incoming>S_f_delay_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_S_Notice_S_GwNotice</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="S_GwNotice" name="Announced by the day before?" default="S_f_notice_no">
      <bpmn:incoming>Flow_S_Notice_S_GwNotice</bpmn:incoming>
      <bpmn:outgoing>S_f_notice_no</bpmn:outgoing>
      <bpmn:outgoing>Flow_S_GwNotice_S_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="S_FM" name="Assess force majeure">
      <bpmn:incoming>S_f_notice_no</bpmn:incoming>
      <bpmn:outgoing>Flow_S_FM_S_GwFM</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="S_GwFM" name="Force majeure?" default="S_f_fm_no">
      <bpmn:incoming>Flow_S_FM_S_GwFM</bpmn:incoming>
      <bpmn:outgoing>S_f_fm_no</bpmn:outgoing>
      <bpmn:outgoing>Flow_S_GwFM_S_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="S_Receipt" name="Check the receipt">
      <bpmn:incoming>S_f_fm_no</bpmn:incoming>
      <bpmn:incoming>Flow_S_Details_S_Receipt</bpmn:incoming>
      <bpmn:outgoing>Flow_S_Receipt_S_GwReceipt</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="S_GwReceipt" name="Receipt complete?" default="S_f_receipt_yes">
      <bpmn:incoming>Flow_S_Receipt_S_GwReceipt</bpmn:incoming>
      <bpmn:outgoing>Flow_S_GwReceipt_S_Ask</bpmn:outgoing>
      <bpmn:outgoing>S_f_receipt_yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="S_Ask" name="Ask passenger for missing details">
      <bpmn:incoming>Flow_S_GwReceipt_S_Ask</bpmn:incoming>
      <bpmn:outgoing>Flow_S_Ask_S_Details</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="S_Details" name="Details received">
      <bpmn:incoming>Flow_S_Ask_S_Details</bpmn:incoming>
      <bpmn:outgoing>Flow_S_Details_S_Receipt</bpmn:outgoing>
      <bpmn:messageEventDefinition id="S_DetailsDef" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="S_Dist" name="Check start and end within 250 m of a station">
      <bpmn:incoming>S_f_receipt_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_S_Dist_S_GwDist</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="S_GwDist" name="Within 250 m?" default="S_f_dist_yes">
      <bpmn:incoming>Flow_S_Dist_S_GwDist</bpmn:incoming>
      <bpmn:outgoing>S_f_dist_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_S_GwDist_S_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="S_Calc" name="Calculate refund (max 300 kr)">
      <bpmn:incoming>S_f_dist_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_S_Calc_S_Transfer</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="S_Transfer" name="Transfer refund">
      <bpmn:incoming>Flow_S_Calc_S_Transfer</bpmn:incoming>
      <bpmn:outgoing>Flow_S_Transfer_S_OutMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="S_Reject" name="Write rejection">
      <bpmn:incoming>Flow_S_GwDelay_S_Reject</bpmn:incoming>
      <bpmn:incoming>Flow_S_GwNotice_S_Reject</bpmn:incoming>
      <bpmn:incoming>Flow_S_GwFM_S_Reject</bpmn:incoming>
      <bpmn:incoming>Flow_S_GwDist_S_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_S_Reject_S_OutMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="S_OutMerge">
      <bpmn:incoming>Flow_S_Transfer_S_OutMerge</bpmn:incoming>
      <bpmn:incoming>Flow_S_Reject_S_OutMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_S_OutMerge_S_Send</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="S_Send" name="Send decision to passenger">
      <bpmn:incoming>Flow_S_OutMerge_S_Send</bpmn:incoming>
      <bpmn:outgoing>Flow_S_Send_S_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="S_End" name="Claim closed">
      <bpmn:incoming>Flow_S_Send_S_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_S_Start_S_Delay" sourceRef="S_Start" targetRef="S_Delay" />
    <bpmn:sequenceFlow id="Flow_S_Delay_S_GwDelay" sourceRef="S_Delay" targetRef="S_GwDelay" />
    <bpmn:sequenceFlow id="S_f_delay_yes" name="yes" sourceRef="S_GwDelay" targetRef="S_Notice" />
    <bpmn:sequenceFlow id="Flow_S_Notice_S_GwNotice" sourceRef="S_Notice" targetRef="S_GwNotice" />
    <bpmn:sequenceFlow id="S_f_notice_no" name="no" sourceRef="S_GwNotice" targetRef="S_FM" />
    <bpmn:sequenceFlow id="Flow_S_FM_S_GwFM" sourceRef="S_FM" targetRef="S_GwFM" />
    <bpmn:sequenceFlow id="S_f_fm_no" name="no" sourceRef="S_GwFM" targetRef="S_Receipt" />
    <bpmn:sequenceFlow id="Flow_S_Receipt_S_GwReceipt" sourceRef="S_Receipt" targetRef="S_GwReceipt" />
    <bpmn:sequenceFlow id="Flow_S_GwReceipt_S_Ask" name="no" sourceRef="S_GwReceipt" targetRef="S_Ask" />
    <bpmn:sequenceFlow id="Flow_S_Ask_S_Details" sourceRef="S_Ask" targetRef="S_Details" />
    <bpmn:sequenceFlow id="Flow_S_Details_S_Receipt" sourceRef="S_Details" targetRef="S_Receipt" />
    <bpmn:sequenceFlow id="S_f_receipt_yes" name="yes" sourceRef="S_GwReceipt" targetRef="S_Dist" />
    <bpmn:sequenceFlow id="Flow_S_Dist_S_GwDist" sourceRef="S_Dist" targetRef="S_GwDist" />
    <bpmn:sequenceFlow id="S_f_dist_yes" name="yes" sourceRef="S_GwDist" targetRef="S_Calc" />
    <bpmn:sequenceFlow id="Flow_S_Calc_S_Transfer" sourceRef="S_Calc" targetRef="S_Transfer" />
    <bpmn:sequenceFlow id="Flow_S_Transfer_S_OutMerge" sourceRef="S_Transfer" targetRef="S_OutMerge" />
    <bpmn:sequenceFlow id="Flow_S_GwDelay_S_Reject" name="no" sourceRef="S_GwDelay" targetRef="S_Reject" />
    <bpmn:sequenceFlow id="Flow_S_GwNotice_S_Reject" name="yes" sourceRef="S_GwNotice" targetRef="S_Reject" />
    <bpmn:sequenceFlow id="Flow_S_GwFM_S_Reject" name="yes" sourceRef="S_GwFM" targetRef="S_Reject" />
    <bpmn:sequenceFlow id="Flow_S_GwDist_S_Reject" name="no" sourceRef="S_GwDist" targetRef="S_Reject" />
    <bpmn:sequenceFlow id="Flow_S_Reject_S_OutMerge" sourceRef="S_Reject" targetRef="S_OutMerge" />
    <bpmn:sequenceFlow id="Flow_S_OutMerge_S_Send" sourceRef="S_OutMerge" targetRef="S_Send" />
    <bpmn:sequenceFlow id="Flow_S_Send_S_End" sourceRef="S_Send" targetRef="S_End" />
  </bpmn:process>
