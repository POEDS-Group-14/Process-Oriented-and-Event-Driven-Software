<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_travel_guarantee" targetNamespace="http://poeds-group-14.dtu.dk/rejsegaranti" exporter="tools/build_bpmn.py" exporterVersion="1.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:documentation>Travel guarantee decision, author Liam Palmqvist</bpmn:documentation>
    <bpmn:participant id="Participant_travel-guarantee" name="Travel guarantee assessment (Movia)" processRef="travel-guarantee" />
    <bpmn:textAnnotation id="Annotation_Author"><bpmn:text>Travel guarantee, Movia bus and local train: when it applies. Author: Liam Palmqvist. Rules: the travel guarantee terms only.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_Delay"><bpmn:text>Actual delay. A +20 min estimate on Rejseplan or a stop screen is not enough: the bus or train may catch up.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Annotation_Scope"><bpmn:text>Covers only the part of the trip the bus or local train should have covered. No other costs (e.g. flight or show tickets, lost earnings).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Delay" sourceRef="Annotation_Delay" targetRef="f_late" />
    <bpmn:association id="Assoc_Scope" sourceRef="Annotation_Scope" targetRef="EndCovered" />
  </bpmn:collaboration>
  <bpmn:process id="travel-guarantee" name="Travel guarantee assessment (Movia)" isExecutable="false">
    <bpmn:startEvent id="Start" name="Bus or local train trip disrupted">
      <bpmn:outgoing>Flow_Start_GwFlex</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GwFlex" name="Flextrafik trip?" default="f_flex_no">
      <bpmn:incoming>Flow_Start_GwFlex</bpmn:incoming>
      <bpmn:outgoing>Flow_GwFlex_EndFlex</bpmn:outgoing>
      <bpmn:outgoing>f_flex_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndFlex" name="Not covered: Flextrafik">
      <bpmn:incoming>Flow_GwFlex_EndFlex</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GwFM" name="Strike, force majeure, or weather made the timetable impossible?" default="f_fm_no">
      <bpmn:incoming>f_flex_no</bpmn:incoming>
      <bpmn:outgoing>Flow_GwFM_EndFM</bpmn:outgoing>
      <bpmn:outgoing>f_fm_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndFM" name="Not covered: strike, weather or force majeure">
      <bpmn:incoming>Flow_GwFM_EndFM</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GwPlan" name="Planned change announced 24 h before?" default="f_plan_no">
      <bpmn:incoming>f_fm_no</bpmn:incoming>
      <bpmn:outgoing>Flow_GwPlan_EndPlan</bpmn:outgoing>
      <bpmn:outgoing>f_plan_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndPlan" name="Not covered: planned change">
      <bpmn:incoming>Flow_GwPlan_EndPlan</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GwWhat" name="What happened?">
      <bpmn:incoming>f_plan_no</bpmn:incoming>
      <bpmn:outgoing>f_late</bpmn:outgoing>
      <bpmn:outgoing>f_passed</bpmn:outgoing>
      <bpmn:outgoing>f_nostop</bpmn:outgoing>
      <bpmn:outgoing>f_early</bpmn:outgoing>
      <bpmn:outgoing>f_conn</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GwVisible" name="Clearly visible to the driver?" default="f_vis_yes">
      <bpmn:incoming>f_passed</bpmn:incoming>
      <bpmn:outgoing>Flow_GwVisible_EndVisible</bpmn:outgoing>
      <bpmn:outgoing>f_vis_yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndVisible" name="Not covered: not visible">
      <bpmn:incoming>Flow_GwVisible_EndVisible</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GwFull" name="Bus full?" default="f_full_no">
      <bpmn:incoming>f_vis_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_GwFull_EndFull</bpmn:outgoing>
      <bpmn:outgoing>f_full_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndFull" name="Not covered: bus full">
      <bpmn:incoming>Flow_GwFull_EndFull</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GwNextB" name="Next bus due within 20 min?" default="f_nextb_no">
      <bpmn:incoming>f_full_no</bpmn:incoming>
      <bpmn:outgoing>Flow_GwNextB_EndNextB</bpmn:outgoing>
      <bpmn:outgoing>f_nextb_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndNextB" name="Not covered: next bus within 20 min">
      <bpmn:incoming>Flow_GwNextB_EndNextB</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GwReq" name="Stop requested in due time?" default="f_req_yes">
      <bpmn:incoming>f_nostop</bpmn:incoming>
      <bpmn:outgoing>Flow_GwReq_EndReq</bpmn:outgoing>
      <bpmn:outgoing>f_req_yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndReq" name="Not covered: stop not requested in time">
      <bpmn:incoming>Flow_GwReq_EndReq</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GwNextD" name="Next bus/train due within 20 min?" default="f_nextd_no">
      <bpmn:incoming>f_early</bpmn:incoming>
      <bpmn:outgoing>Flow_GwNextD_EndNextD</bpmn:outgoing>
      <bpmn:outgoing>f_nextd_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndNextD" name="Not covered: next departure within 20 min">
      <bpmn:incoming>Flow_GwNextD_EndNextD</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndConn" name="Not covered: missed connection">
      <bpmn:incoming>f_conn</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GwCovered">
      <bpmn:incoming>f_late</bpmn:incoming>
      <bpmn:incoming>f_nextb_no</bpmn:incoming>
      <bpmn:incoming>f_req_yes</bpmn:incoming>
      <bpmn:incoming>f_nextd_no</bpmn:incoming>
      <bpmn:outgoing>Flow_GwCovered_EndCovered</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndCovered" name="Travel guarantee applies">
      <bpmn:incoming>Flow_GwCovered_EndCovered</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_GwFlex" sourceRef="Start" targetRef="GwFlex" />
    <bpmn:sequenceFlow id="Flow_GwFlex_EndFlex" name="yes" sourceRef="GwFlex" targetRef="EndFlex" />
    <bpmn:sequenceFlow id="f_flex_no" name="no" sourceRef="GwFlex" targetRef="GwFM" />
    <bpmn:sequenceFlow id="Flow_GwFM_EndFM" name="yes" sourceRef="GwFM" targetRef="EndFM" />
    <bpmn:sequenceFlow id="f_fm_no" name="no" sourceRef="GwFM" targetRef="GwPlan" />
    <bpmn:sequenceFlow id="Flow_GwPlan_EndPlan" name="yes" sourceRef="GwPlan" targetRef="EndPlan" />
    <bpmn:sequenceFlow id="f_plan_no" name="no" sourceRef="GwPlan" targetRef="GwWhat" />
    <bpmn:sequenceFlow id="f_late" name="More than 20 min late" sourceRef="GwWhat" targetRef="GwCovered" />
    <bpmn:sequenceFlow id="f_passed" name="Bus drove past the stop" sourceRef="GwWhat" targetRef="GwVisible" />
    <bpmn:sequenceFlow id="f_nostop" name="Local train did not stop" sourceRef="GwWhat" targetRef="GwReq" />
    <bpmn:sequenceFlow id="f_early" name="Left over 2 min early" sourceRef="GwWhat" targetRef="GwNextD" />
    <bpmn:sequenceFlow id="f_conn" name="Missed connection after a delay" sourceRef="GwWhat" targetRef="EndConn" />
    <bpmn:sequenceFlow id="Flow_GwVisible_EndVisible" name="no" sourceRef="GwVisible" targetRef="EndVisible" />
    <bpmn:sequenceFlow id="f_vis_yes" name="yes" sourceRef="GwVisible" targetRef="GwFull" />
    <bpmn:sequenceFlow id="Flow_GwFull_EndFull" name="yes" sourceRef="GwFull" targetRef="EndFull" />
    <bpmn:sequenceFlow id="f_full_no" name="no" sourceRef="GwFull" targetRef="GwNextB" />
    <bpmn:sequenceFlow id="Flow_GwNextB_EndNextB" name="yes" sourceRef="GwNextB" targetRef="EndNextB" />
    <bpmn:sequenceFlow id="f_nextb_no" name="no" sourceRef="GwNextB" targetRef="GwCovered" />
    <bpmn:sequenceFlow id="Flow_GwReq_EndReq" name="no" sourceRef="GwReq" targetRef="EndReq" />
    <bpmn:sequenceFlow id="f_req_yes" name="yes" sourceRef="GwReq" targetRef="GwCovered" />
    <bpmn:sequenceFlow id="Flow_GwNextD_EndNextD" name="yes" sourceRef="GwNextD" targetRef="EndNextD" />
    <bpmn:sequenceFlow id="f_nextd_no" name="no" sourceRef="GwNextD" targetRef="GwCovered" />
    <bpmn:sequenceFlow id="Flow_GwCovered_EndCovered" sourceRef="GwCovered" targetRef="EndCovered" />
  </bpmn:process>
