# Template. The real settings go in deploy/recorder.env (not committed to git).
RECORDER_DATA_DIR=/var/lib/rejsegaranti-recorder
# Where to observe the weather (default: central Copenhagen)
RECORDER_LAT=55.6761
RECORDER_LON=12.5683

# OpenWeatherMap: https://openweathermap.org/api (free account, API key under "My API keys")
OWM_API_KEY=
OWM_INTERVAL_S=600

# DMI Open Data: metObs works without a key in practice; set one only if DMI starts refusing requests
DMI_API_KEY=
# pick one with: python -m recorder dmi-stations
DMI_STATION_ID=
DMI_INTERVAL_S=600

# Dataudveksleren (Movia real-time over Azure Service Bus). For each subscribed dataset, copy the AMQP url
# from its "Subscribe to events" popup; separate several with commas. The tenant ID is in the same popup;
# client ID and password belong to the service account.
SB_AMQP_URLS=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Process-1 bridge: send delays on these lines ("*": every line), and the weather, as CEP situations (empty: don't send).
# The server sets these in its systemd unit.
BRIDGE_URL=
BRIDGE_LINES=

# Movia travel guarantee thresholds
DELAY_THRESHOLD_MIN=20
EARLY_THRESHOLD_MIN=2
