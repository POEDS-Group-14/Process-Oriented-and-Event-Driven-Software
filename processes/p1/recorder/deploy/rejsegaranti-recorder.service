[Unit]
Description=Rejsegaranti recorder (Movia real-time, OpenWeatherMap, DMI)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=rejsegaranti
Group=rejsegaranti
WorkingDirectory=/opt/rejsegaranti/recorder
EnvironmentFile=-/etc/rejsegaranti-recorder.env
Environment=PYTHONUNBUFFERED=1
# send every line's delays and the weather to the process-1 bridge, which keeps the lines in data/stations.csv
Environment=BRIDGE_URL=http://localhost:8090
Environment=BRIDGE_LINES=*
ExecStart=/usr/bin/python3 -m recorder run
Restart=always
RestartSec=30
StateDirectory=rejsegaranti-recorder
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/var/lib/rejsegaranti-recorder

[Install]
WantedBy=multi-user.target
