digraph DCR {
  graph [rankdir=LR, fontname="Helvetica", labelloc=t, fontsize=18,
         label="Rejsegaranti claim: DCR compliance rules  (author: Liam Palmqvist)\norange = condition, blue = response, red % = exclude"];
  node [shape=box, style="rounded,filled", fillcolor="#f8f8f8", fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];
  e0 [label="Passenger\n\nClaim submitted"];
  e1 [label="Claim engine\n\nMatch claim to CEP delay situation"];
  e2 [label="Claim engine\n\nNo verified delay"];
  e3 [label="Claim engine\n\nPlanned change announced by the day before"];
  e4 [label="Claim engine\n\nForce majeure"];
  e5 [label="Claim engine\n\nDelay verified"];
  e6 [label="Claim engine\n\nCheck receipt"];
  e7 [label="Claim engine\n\nCheck distance to stations"];
  e8 [label="Claim engine\n\nReceipt rejected"];
  e9 [label="Claim engine\n\nReceipt verified"];
  e10 [label="Claim engine\n\nTrip outside 250 m"];
  e11 [label="Claim engine\n\nTrip within 250 m"];
  e12 [label="Claim engine\n\nCalculate payout"];
  e13 [label="Finance\n\nPay out claim"];
  e14 [label="Claim engine\n\nReject claim"];
  e15 [label="Claim engine\n\nReport claim outcome to CEP"];
  e16 [label="Claim engine\n\nClaim closed"];
  e0 -> e1 [color="#e8a33d" arrowhead=dotnormal];
  e1 -> e5 [color="#e8a33d" arrowhead=dotnormal];
  e1 -> e2 [color="#e8a33d" arrowhead=dotnormal];
  e5 -> e6 [color="#e8a33d" arrowhead=dotnormal];
  e5 -> e7 [color="#e8a33d" arrowhead=dotnormal];
  e6 -> e9 [color="#e8a33d" arrowhead=dotnormal];
  e6 -> e8 [color="#e8a33d" arrowhead=dotnormal];
  e7 -> e11 [color="#e8a33d" arrowhead=dotnormal];
  e7 -> e10 [color="#e8a33d" arrowhead=dotnormal];
  e9 -> e13 [color="#e8a33d" arrowhead=dotnormal];
  e8 -> e13 [color="#d64545" arrowhead=normal label="%" fontcolor="#d64545"];
  e3 -> e13 [color="#d64545" arrowhead=normal label="%" fontcolor="#d64545"];
  e4 -> e13 [color="#d64545" arrowhead=normal label="%" fontcolor="#d64545"];
  e2 -> e13 [color="#d64545" arrowhead=normal label="%" fontcolor="#d64545"];
  e5 -> e13 [color="#e8a33d" arrowhead=dotnormal];
  e11 -> e13 [color="#e8a33d" arrowhead=dotnormal];
  e10 -> e13 [color="#d64545" arrowhead=normal label="%" fontcolor="#d64545"];
  e12 -> e13 [color="#e8a33d" arrowhead=dotnormal];
  e13 -> e13 [color="#d64545" arrowhead=normal label="%" fontcolor="#d64545"];
  e13 -> e14 [color="#d64545" arrowhead=normal label="%" fontcolor="#d64545"];
  e14 -> e13 [color="#d64545" arrowhead=normal label="%" fontcolor="#d64545"];
  e0 -> e15 [color="#2a7de1" arrowtail=dot dir=both arrowhead=normal];
  e13 -> e15 [color="#e8a33d" arrowhead=dotnormal];
  e14 -> e15 [color="#e8a33d" arrowhead=dotnormal];
  e15 -> e15 [color="#d64545" arrowhead=normal label="%" fontcolor="#d64545"];
  e11 -> e13 [color="#2a7de1" arrowtail=dot dir=both arrowhead=normal];
  e11 -> e14 [color="#d64545" arrowhead=normal label="%" fontcolor="#d64545"];
  e15 -> e16 [color="#e8a33d" arrowhead=dotnormal];
}
