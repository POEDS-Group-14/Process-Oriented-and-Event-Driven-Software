digraph DCR {
  graph [rankdir=LR, splines=ortho, fontname="Helvetica", labelloc=t, fontsize=18,
         label="Rejsegaranti claim: DCR compliance rules  (author: Liam Palmqvist)\norange = condition, blue = response, red % = exclude"];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];
  e0 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" STYLE="rounded" BGCOLOR="white"><TR><TD WIDTH="100" HEIGHT="22" FIXEDSIZE="TRUE"><FONT POINT-SIZE="9" COLOR="#555555">Passenger</FONT></TD></TR><HR/><TR><TD WIDTH="100" HEIGHT="78" FIXEDSIZE="TRUE">Claim submitted</TD></TR></TABLE>>];
  e1 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" STYLE="rounded" BGCOLOR="white"><TR><TD WIDTH="100" HEIGHT="22" FIXEDSIZE="TRUE"><FONT POINT-SIZE="9" COLOR="#555555">Claim engine</FONT></TD></TR><HR/><TR><TD WIDTH="100" HEIGHT="78" FIXEDSIZE="TRUE">Match claim to<BR/>CEP delay<BR/>situation</TD></TR></TABLE>>];
  e2 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" STYLE="rounded" BGCOLOR="white"><TR><TD WIDTH="100" HEIGHT="22" FIXEDSIZE="TRUE"><FONT POINT-SIZE="9" COLOR="#555555">Claim engine</FONT></TD></TR><HR/><TR><TD WIDTH="100" HEIGHT="78" FIXEDSIZE="TRUE">No verified<BR/>delay</TD></TR></TABLE>>];
  e3 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" STYLE="rounded" BGCOLOR="white"><TR><TD WIDTH="100" HEIGHT="22" FIXEDSIZE="TRUE"><FONT POINT-SIZE="9" COLOR="#555555">Claim engine</FONT></TD></TR><HR/><TR><TD WIDTH="100" HEIGHT="78" FIXEDSIZE="TRUE">Planned change<BR/>announced by<BR/>the day before</TD></TR></TABLE>>];
  e4 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" STYLE="rounded" BGCOLOR="white"><TR><TD WIDTH="100" HEIGHT="22" FIXEDSIZE="TRUE"><FONT POINT-SIZE="9" COLOR="#555555">Claim engine</FONT></TD></TR><HR/><TR><TD WIDTH="100" HEIGHT="78" FIXEDSIZE="TRUE">Force majeure</TD></TR></TABLE>>];
  e5 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" STYLE="rounded" BGCOLOR="white"><TR><TD WIDTH="100" HEIGHT="22" FIXEDSIZE="TRUE"><FONT POINT-SIZE="9" COLOR="#555555">Claim engine</FONT></TD></TR><HR/><TR><TD WIDTH="100" HEIGHT="78" FIXEDSIZE="TRUE">Delay verified</TD></TR></TABLE>>];
  e6 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" STYLE="rounded" BGCOLOR="white"><TR><TD WIDTH="100" HEIGHT="22" FIXEDSIZE="TRUE"><FONT POINT-SIZE="9" COLOR="#555555">Claim engine</FONT></TD></TR><HR/><TR><TD WIDTH="100" HEIGHT="78" FIXEDSIZE="TRUE">Check receipt</TD></TR></TABLE>>];
  e7 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" STYLE="rounded" BGCOLOR="white"><TR><TD WIDTH="100" HEIGHT="22" FIXEDSIZE="TRUE"><FONT POINT-SIZE="9" COLOR="#555555">Claim engine</FONT></TD></TR><HR/><TR><TD WIDTH="100" HEIGHT="78" FIXEDSIZE="TRUE">Check distance<BR/>to stations</TD></TR></TABLE>>];
  e8 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" STYLE="rounded" BGCOLOR="white"><TR><TD WIDTH="100" HEIGHT="22" FIXEDSIZE="TRUE"><FONT POINT-SIZE="9" COLOR="#555555">Claim engine</FONT></TD></TR><HR/><TR><TD WIDTH="100" HEIGHT="78" FIXEDSIZE="TRUE">Receipt<BR/>rejected</TD></TR></TABLE>>];
  e9 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" STYLE="rounded" BGCOLOR="white"><TR><TD WIDTH="100" HEIGHT="22" FIXEDSIZE="TRUE"><FONT POINT-SIZE="9" COLOR="#555555">Claim engine</FONT></TD></TR><HR/><TR><TD WIDTH="100" HEIGHT="78" FIXEDSIZE="TRUE">Receipt<BR/>verified</TD></TR></TABLE>>];
  e10 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" STYLE="rounded" BGCOLOR="white"><TR><TD WIDTH="100" HEIGHT="22" FIXEDSIZE="TRUE"><FONT POINT-SIZE="9" COLOR="#555555">Claim engine</FONT></TD></TR><HR/><TR><TD WIDTH="100" HEIGHT="78" FIXEDSIZE="TRUE">Trip outside<BR/>250 m</TD></TR></TABLE>>];
  e11 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" STYLE="rounded" BGCOLOR="white"><TR><TD WIDTH="100" HEIGHT="22" FIXEDSIZE="TRUE"><FONT POINT-SIZE="9" COLOR="#555555">Claim engine</FONT></TD></TR><HR/><TR><TD WIDTH="100" HEIGHT="78" FIXEDSIZE="TRUE">Trip within<BR/>250 m</TD></TR></TABLE>>];
  e12 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" STYLE="rounded" BGCOLOR="white"><TR><TD WIDTH="100" HEIGHT="22" FIXEDSIZE="TRUE"><FONT POINT-SIZE="9" COLOR="#555555">Claim engine</FONT></TD></TR><HR/><TR><TD WIDTH="100" HEIGHT="78" FIXEDSIZE="TRUE">Calculate<BR/>payout</TD></TR></TABLE>>];
  e13 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" STYLE="rounded" BGCOLOR="white"><TR><TD WIDTH="100" HEIGHT="22" FIXEDSIZE="TRUE"><FONT POINT-SIZE="9" COLOR="#555555">Finance</FONT></TD></TR><HR/><TR><TD WIDTH="100" HEIGHT="78" FIXEDSIZE="TRUE">Pay out claim</TD></TR></TABLE>>];
  e14 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" STYLE="rounded" BGCOLOR="white"><TR><TD WIDTH="100" HEIGHT="22" FIXEDSIZE="TRUE"><FONT POINT-SIZE="9" COLOR="#555555">Claim engine</FONT></TD></TR><HR/><TR><TD WIDTH="100" HEIGHT="78" FIXEDSIZE="TRUE">Reject claim</TD></TR></TABLE>>];
  e15 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" STYLE="rounded" BGCOLOR="white"><TR><TD WIDTH="100" HEIGHT="22" FIXEDSIZE="TRUE"><FONT POINT-SIZE="9" COLOR="#555555">Claim engine</FONT></TD></TR><HR/><TR><TD WIDTH="100" HEIGHT="78" FIXEDSIZE="TRUE">Report claim<BR/>outcome to CEP</TD></TR></TABLE>>];
  e16 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" STYLE="rounded" BGCOLOR="white"><TR><TD WIDTH="100" HEIGHT="22" FIXEDSIZE="TRUE"><FONT POINT-SIZE="9" COLOR="#555555">Claim engine</FONT></TD></TR><HR/><TR><TD WIDTH="100" HEIGHT="78" FIXEDSIZE="TRUE">Claim closed</TD></TR></TABLE>>];
  e0 -> e1 [color="#e8a33d" arrowhead=dotnormal];
  e1 -> e5 [color="#e8a33d" arrowhead=dotnormal];
  e1 -> e2 [color="#e8a33d" arrowhead=dotnormal];
  e5 -> e6 [color="#e8a33d" arrowhead=dotnormal];
  e5 -> e7 [color="#e8a33d" arrowhead=dotnormal];
  e6 -> e9 [color="#e8a33d" arrowhead=dotnormal];
  e6 -> e8 [color="#e8a33d" arrowhead=dotnormal];
  e7 -> e11 [color="#e8a33d" arrowhead=dotnormal];
  e7 -> e10 [color="#e8a33d" arrowhead=dotnormal];
  e9 -> e13 [color="#e8a33d" arrowhead=dotnormal];
  e8 -> e13 [color="#d64545" arrowhead=normal headlabel="%" fontcolor="#d64545"];
  e3 -> e13 [color="#d64545" arrowhead=normal headlabel="%" fontcolor="#d64545"];
  e4 -> e13 [color="#d64545" arrowhead=normal headlabel="%" fontcolor="#d64545"];
  e2 -> e13 [color="#d64545" arrowhead=normal headlabel="%" fontcolor="#d64545"];
  e5 -> e13 [color="#e8a33d" arrowhead=dotnormal];
  e11 -> e13 [color="#e8a33d" arrowhead=dotnormal];
  e10 -> e13 [color="#d64545" arrowhead=normal headlabel="%" fontcolor="#d64545"];
  e12 -> e13 [color="#e8a33d" arrowhead=dotnormal];
  e13 -> e13 [color="#d64545" arrowhead=normal headlabel="%" fontcolor="#d64545"];
  e13 -> e14 [color="#d64545" arrowhead=normal headlabel="%" fontcolor="#d64545"];
  e14 -> e13 [color="#d64545" arrowhead=normal headlabel="%" fontcolor="#d64545"];
  e0 -> e15 [color="#2a7de1" arrowtail=dot dir=both arrowhead=normal];
  e13 -> e15 [color="#e8a33d" arrowhead=dotnormal];
  e14 -> e15 [color="#e8a33d" arrowhead=dotnormal];
  e15 -> e15 [color="#d64545" arrowhead=normal headlabel="%" fontcolor="#d64545"];
  e11 -> e13 [color="#2a7de1" arrowtail=dot dir=both arrowhead=normal];
  e11 -> e14 [color="#d64545" arrowhead=normal headlabel="%" fontcolor="#d64545"];
  e15 -> e16 [color="#e8a33d" arrowhead=dotnormal];
}
