[Unit]
Description=Process 1 (rejsegaranti): simulated claims for the real bus 150S delays
Wants=rejsegaranti-bridge.service
After=rejsegaranti-bridge.service

[Service]
Type=simple
User=rejsegaranti
Group=rejsegaranti
WorkingDirectory=/opt/rejsegaranti/service
Environment=PYTHONPATH=/opt/rejsegaranti/service
Environment=PYTHONUNBUFFERED=1
Environment=REJSEGARANTI_LINE=150S
ExecStartPre=/bin/sh -c 'until curl -sf http://localhost:8090/state >/dev/null; do sleep 5; done'
ExecStart=/usr/bin/python3 -m rejsegaranti feed --real --interval 300
TimeoutStartSec=600
Restart=always
RestartSec=60
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
